{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectbuilder.dev/schemas/project-builder-projection.schema.json",
  "title": "Project Builder Projection Package",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "projectionId",
    "projectionKind",
    "projectionVersion",
    "source",
    "generator",
    "generatedAt",
    "artifacts",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "format": {
      "const": "project-builder-projection"
    },
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "projectionId": {
      "type": "string",
      "format": "uuid"
    },
    "projectionKind": {
      "type": "string",
      "enum": [
        "behaviorSpecification",
        "stateTable",
        "decisionTable",
        "contract",
        "implementationSlice",
        "traceability",
        "evidenceMatrix",
        "reviewPacket",
        "releasePacket",
        "schema",
        "scaffoldPlan",
        "custom"
      ]
    },
    "projectionVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source": {
      "type": "object",
      "required": [
        "projectId",
        "projectRevision",
        "scopeElementIds",
        "purposeProfile"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "projectRevision": {
          "type": "integer",
          "minimum": 1
        },
        "baselineId": {
          "type": "string",
          "format": "uuid"
        },
        "scopeElementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "purposeProfile": {
          "type": "string",
          "enum": [
            "discovery",
            "interfaceDesign",
            "architecture",
            "implementationReady",
            "releaseReady",
            "custom"
          ]
        },
        "semanticContentHash": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "configurationHash": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deterministic": {
      "type": "boolean",
      "default": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "name",
          "mediaType",
          "relativePath",
          "digest",
          "ownership"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "not": {
              "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
            }
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "ownership": {
            "type": "string",
            "enum": [
              "generated",
              "reviewOnly",
              "userOwnedTemplate"
            ]
          },
          "sourceElementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "inlineText": {
            "type": "string",
            "maxLength": 1000000
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,100}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "advisory"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 20000
          },
          "elementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true
          },
          "repair": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "includedElementIds",
        "excludedElementIds",
        "unsupportedElementIds"
      ],
      "properties": {
        "includedElementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "excludedElementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "unsupportedElementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

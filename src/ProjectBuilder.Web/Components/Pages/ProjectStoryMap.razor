@page "/projects/{ProjectId}/story-map"
@using Microsoft.AspNetCore.Components

<PageTitle>Story Map · Project Builder</PageTitle>
<main class="product-page story-map-page">
    <nav aria-label="Breadcrumb"><a href="/projects/@ProjectId">Project overview</a> <span aria-hidden="true">/</span> Story Map</nav>
    <ProjectBuilder.Web.Client.Components.StoryMapStudio ProjectId="@ProjectId"
        @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
</main>

@code { [Parameter] public string ProjectId { get; set; } = string.Empty; }

@page "/projects/{ProjectId}/recommendations"

<PageTitle>Next-action decision lens · Project Builder</PageTitle>
<main class="product-page recommendation-page">
    <nav aria-label="Breadcrumb"><a href="/projects/@ProjectId">Project overview</a> <span aria-hidden="true">/</span> Next-action decision lens</nav>
    <ProjectBuilder.Web.Client.Components.RecommendationStudio ProjectId="@ProjectId" Profile="@Profile" @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
</main>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "profile")] public string Profile { get; set; } = "discovery";
}

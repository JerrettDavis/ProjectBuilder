@page "/projects/{ProjectId}/workshop"
@using Microsoft.AspNetCore.Components

<PageTitle>Workshop studio · Project Builder</PageTitle>
<main class="product-page">
    <nav aria-label="Breadcrumb"><a href="/projects/@ProjectId">Project overview</a> <span aria-hidden="true">/</span> Workshop studio</nav>
    <ProjectBuilder.Web.Client.Components.WorkshopStudio ProjectId="@ProjectId" Profile="@Profile"
        @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
</main>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = "profile")] public string Profile { get; set; } = "discovery";
}

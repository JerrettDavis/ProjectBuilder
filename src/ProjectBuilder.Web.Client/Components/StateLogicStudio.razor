@namespace ProjectBuilder.Web.Client.Components
@inject HttpClient Http
@inject BrowserDraftStore Drafts

<section id="state-editor-workspace" class="state-studio" aria-labelledby="state-studio-heading" data-testid="state-logic-studio">
    <EditorKeyboardShortcuts ScopeId="state-editor-workspace" Commit="CommitAsync" Undo="UndoAsync" Redo="RedoAsync" />
    <header class="state-studio-header"><div><p class="eyebrow">State lens · explicit truth</p><h1 id="state-studio-heading">Define state and logic</h1><p>Model owned facts, governing logic, falsifiable invariants, typed results, and a transition without collapsing domain, workflow, presentation, infrastructure, or observed state.</p></div><div class="draft-state"><span class="status-dot @(_dirty ? "staged" : "clean")"></span><strong>@(_dirty ? "Staged state model" : "Clean draft")</strong><small>@ReadinessCount/5 definition groups ready</small></div></header>

    @if (_loading) { <div class="editor-loading" role="status">Loading state owners and current model…</div> }
    else if (_loadError is not null) { <div class="error-summary" role="alert"><h2>State Studio unavailable</h2><p>@_loadError</p><button class="secondary-action" @onclick="LoadAsync">Try again</button></div> }
    else if (_actors.Count == 0) { <section class="editor-empty-state" role="alert"><p class="eyebrow">Missing authority</p><h2>An owning actor is required</h2><p>State and rule authority must reference a modeled participant.</p><a class="primary-action" href="/projects/@ProjectId/actors/new">Add actor</a></section> }
    else if (_committed is not null)
    {
        <section class="editor-commit-success" role="status" data-testid="state-logic-committed"><p class="eyebrow">Revision @_committed.Revision committed</p><h2>@_committed.Definitions.StateName defined</h2><p>@_committed.Definitions.TransitionName now evaluates @_committed.Definitions.Results.Count typed semantic results.</p><p>@_committed.AllowedNextAction</p><div class="editor-actions"><a class="primary-action" href="/projects/@ProjectId">Review state and logic</a><a class="secondary-action" href="/projects/@ProjectId/state-logic/new">Define another state</a></div></section>
    }
    else
    {
        @if (_recovered) { <div class="draft-recovery @(_staleDraft ? "stale" : null)" role="status" data-testid="state-draft-recovered"><div><p class="eyebrow">Browser-local recovery</p><strong>@(_staleDraft ? "State draft is based on an earlier revision" : "State draft restored after refresh")</strong><p>The state topology remains local until its typed command commits.</p></div>@if (_staleDraft) { <button type="button" class="secondary-action" @onclick="RefreshRevisionAsync">Use latest revision and keep draft</button> }</div> }
        <div class="state-workbench">
            <aside class="state-catalog" aria-label="State definition catalog"><p class="eyebrow">Definition catalog</p><ol>@foreach (var item in Catalog) { <li class="@(item.Ready ? "ready" : null)"><span>@item.Order</span><div><strong>@item.Kind</strong><small>@item.Label</small></div></li> }</ol><div class="category-key"><span>State category</span><strong>@CategoryLabel</strong><small>Categories remain semantically distinct.</small></div></aside>

            <form class="state-canvas" @onsubmit="CommitAsync" @onsubmit:preventDefault>
                @if (_serverErrors.Count > 0) { <div class="error-summary" role="alert"><h2>Command rejected</h2><ul>@foreach (var error in _serverErrors) { <li>@error</li> }</ul>@if (_conflict) { <button type="button" class="secondary-action" @onclick="RefreshRevisionAsync">Refresh revision and keep draft</button> }</div> }

                <section class="state-node state-definition-node" aria-labelledby="state-definition-heading"><div class="state-node-title"><span>01</span><div><p>Canonical state</p><h2 id="state-definition-heading">State catalog entry</h2></div><strong class="node-chip">@CategoryLabel</strong></div><div class="state-field-grid three"><StudioField Descriptor="StateNameField"><input id="state-name" value="@_draft.StateName" @oninput="e => Change(nameof(_draft.StateName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="CategoryField"><select id="state-category" value="@_draft.StateCategory" @onchange="e => Change(nameof(_draft.StateCategory), e.Value?.ToString())"><option value="Domain">Domain</option><option value="ApplicationWorkflow">Application workflow</option><option value="Presentation">Presentation</option><option value="Infrastructure">Infrastructure</option><option value="ExternalObserved">External observed</option></select></StudioField><StudioField Descriptor="OwnerField"><select id="state-owner" value="@_draft.OwnerId" @onchange="e => Change(nameof(_draft.OwnerId), e.Value?.ToString())">@foreach (var actor in _actors) { <option value="@actor.Id">@actor.Name</option> }</select></StudioField><StudioField Descriptor="StructureField"><textarea id="state-structure" rows="4" value="@_draft.StateStructure" @oninput="e => Change(nameof(_draft.StateStructure), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ValuesField"><textarea id="state-values" rows="4" value="@_draft.StateValues" @oninput="e => Change(nameof(_draft.StateValues), e.Value?.ToString())"></textarea></StudioField></div></section>

                <div class="state-binding" aria-hidden="true"><span>owns truth</span><i>↓</i></div>
                <div class="logic-deck">
                    <section class="state-node fact-node" aria-labelledby="fact-heading"><div class="state-node-title"><span>02</span><div><p>Authoritative datum</p><h2 id="fact-heading">Fact</h2></div></div><StudioField Descriptor="FactNameField"><input id="fact-name" value="@_draft.FactName" @oninput="e => Change(nameof(_draft.FactName), e.Value?.ToString())" /></StudioField><div class="state-field-grid two"><StudioField Descriptor="FactTypeField"><input id="fact-type" value="@_draft.FactValueType" @oninput="e => Change(nameof(_draft.FactValueType), e.Value?.ToString())" /></StudioField><StudioField Descriptor="MutabilityField"><select id="fact-mutability" value="@_draft.FactMutability" @onchange="e => Change(nameof(_draft.FactMutability), e.Value?.ToString())"><option>Transitioned</option><option>Immutable</option><option>Derived</option><option>Observed</option></select></StudioField></div><StudioField Descriptor="AuthorityField"><textarea id="fact-authority" rows="3" value="@_draft.FactAuthority" @oninput="e => Change(nameof(_draft.FactAuthority), e.Value?.ToString())"></textarea></StudioField></section>
                    <section class="state-node rule-node" aria-labelledby="rule-heading"><div class="state-node-title"><span>03</span><div><p>Evaluated logic</p><h2 id="rule-heading">Rule</h2></div></div><StudioField Descriptor="RuleNameField"><input id="rule-name" value="@_draft.RuleName" @oninput="e => Change(nameof(_draft.RuleName), e.Value?.ToString())" /></StudioField><div class="state-field-grid two"><StudioField Descriptor="RuleKindField"><select id="rule-kind" value="@_draft.RuleKind" @onchange="e => Change(nameof(_draft.RuleKind), e.Value?.ToString())"><option>Validation</option><option>Eligibility</option><option>Decision</option><option>Derivation</option><option>Calculation</option><option>Policy</option></select></StudioField><StudioField Descriptor="RuleOwnerField"><select id="rule-owner" value="@_draft.RuleAuthorityOwnerId" @onchange="e => Change(nameof(_draft.RuleAuthorityOwnerId), e.Value?.ToString())">@foreach (var actor in _actors) { <option value="@actor.Id">@actor.Name</option> }</select></StudioField></div><StudioField Descriptor="RuleStatementField"><textarea id="rule-statement" rows="3" value="@_draft.RuleStatement" @oninput="e => Change(nameof(_draft.RuleStatement), e.Value?.ToString())"></textarea></StudioField></section>
                </div>

                <div class="state-binding split" aria-hidden="true"><span>constrains transition</span><i>↓</i></div>
                <section class="state-node invariant-node" aria-labelledby="invariant-heading"><div class="state-node-title"><span>04</span><div><p>Must always hold</p><h2 id="invariant-heading">Invariant and proof contract</h2></div><strong class="node-chip @(ProofCount > 0 ? "verified" : null)">@ProofCount proof expectations</strong></div><div class="state-field-grid two"><div><StudioField Descriptor="InvariantNameField"><input id="invariant-name" value="@_draft.InvariantName" @oninput="e => Change(nameof(_draft.InvariantName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="InvariantStatementField"><textarea id="invariant-statement" rows="3" value="@_draft.InvariantStatement" @oninput="e => Change(nameof(_draft.InvariantStatement), e.Value?.ToString())"></textarea></StudioField></div><div><StudioField Descriptor="FalsifierField"><textarea id="falsifying-example" rows="3" value="@_draft.FalsifyingExample" @oninput="e => Change(nameof(_draft.FalsifyingExample), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ProofField"><textarea id="proof-expectation" rows="3" value="@_draft.ProofExpectation" @oninput="e => Change(nameof(_draft.ProofExpectation), e.Value?.ToString())"></textarea></StudioField></div></div></section>

                <div class="state-binding" aria-hidden="true"><span>guards state change</span><i>↓</i></div>
                <section class="state-node transition-node" aria-labelledby="transition-heading"><div class="state-node-title"><span>05</span><div><p>State transition table</p><h2 id="transition-heading">Transition topology</h2></div></div><StudioField Descriptor="TransitionNameField"><input id="transition-name" value="@_draft.TransitionName" @oninput="e => Change(nameof(_draft.TransitionName), e.Value?.ToString())" /></StudioField><div class="transition-flow" data-testid="transition-flow"><div><span>Current predicate</span><label for="source-predicate">Source state predicate *</label><textarea id="source-predicate" rows="4" value="@_draft.SourcePredicate" @oninput="e => Change(nameof(_draft.SourcePredicate), e.Value?.ToString())"></textarea></div><i aria-hidden="true">→</i><div class="trigger-gate"><span>Trigger</span><label for="transition-trigger">Trigger *</label><textarea id="transition-trigger" rows="4" value="@_draft.Trigger" @oninput="e => Change(nameof(_draft.Trigger), e.Value?.ToString())"></textarea><small>@_draft.RuleKind rule · invariant enforced</small></div><i aria-hidden="true">→</i><div><span>Next predicate</span><label for="target-predicate">Target state predicate *</label><textarea id="target-predicate" rows="4" value="@_draft.TargetPredicate" @oninput="e => Change(nameof(_draft.TargetPredicate), e.Value?.ToString())"></textarea></div></div>
                    <StudioField Descriptor="ResultsField"><textarea id="semantic-results" rows="5" value="@_draft.SemanticResults" @oninput="e => Change(nameof(_draft.SemanticResults), e.Value?.ToString())"></textarea></StudioField>
                    <div class="result-matrix" data-testid="result-path-matrix"><div class="matrix-heading"><div><p class="eyebrow">Result / path matrix</p><h3>Explicit outcomes from this transition</h3></div><span>@ResultRows.Count typed</span></div><div role="table" aria-label="Semantic result path matrix"><div role="row" class="matrix-row header"><span role="columnheader">Result</span><span role="columnheader">Kind</span><span role="columnheader">Meaning</span><span role="columnheader">Path status</span></div>@if (ResultRows.Count == 0) { <p class="matrix-empty">Add results as <code>Name | Kind | Meaning</code>. Paths remain unmodeled until the next command.</p> } else { @foreach (var row in ResultRows) { <div role="row" class="matrix-row"><strong role="cell">@row.Name</strong><span role="cell" class="result-kind">@row.Kind</span><span role="cell">@row.Meaning</span><span role="cell" class="path-status">Unmodeled · next slice</span></div> } }</div></div>
                </section>

                <section class="state-commit-preview"><div><p class="eyebrow">Atomic state packet</p><h2>Review semantic operations</h2><p>State, fact, rule, invariant, @ResultRows.Count result(s), and transition commit together. The transition explicitly references the fact, rule, invariant, and every result.</p></div><StudioField Descriptor="ReasonField"><input id="state-reason" value="@_draft.Reason" @oninput="e => Change(nameof(_draft.Reason), e.Value?.ToString())" /></StudioField></section>
                <div class="editor-command-bar"><div><span>Command</span><code>projectbuilder.state-logic.define</code><small>Expected revision @_revision · one transaction · Ctrl+S commit</small></div><div class="editor-actions"><button type="button" class="secondary-action" data-testid="state-undo" @onclick="UndoAsync" disabled="@(_undo.Count == 0 || _submitting)">Undo</button><button type="button" class="secondary-action" data-testid="state-redo" @onclick="RedoAsync" disabled="@(_redo.Count == 0 || _submitting)">Redo</button><button type="button" class="secondary-action" @onclick="ResetAsync" disabled="@(!_dirty || _submitting)">Discard draft</button><button type="submit" class="primary-action" disabled="@(!CanCommit || _submitting || _staleDraft)">@(_submitting ? "Committing…" : "Commit state and logic")</button></div></div>
            </form>

            <aside class="state-inspector" aria-labelledby="state-readiness-heading"><p class="eyebrow">State inspector</p><h2 id="state-readiness-heading">Definition readiness</h2><div class="readiness-score"><strong>@ReadinessCount/5</strong><span>groups ready</span></div><dl><div><dt>Owner</dt><dd>@OwnerName</dd></div><div><dt>Category</dt><dd>@CategoryLabel</dd></div><div><dt>Structure</dt><dd>@LineCount(_draft.StateStructure) fields</dd></div><div><dt>Results</dt><dd>@ResultRows.Count typed</dd></div><div><dt>Proof</dt><dd>@ProofCount expectations</dd></div></dl><p class="inspector-note">The topology is a projection. Only the typed command changes semantic truth; path rows remain explicitly unmodeled until connected by the path command.</p></aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = "";
    private readonly List<string> _serverErrors = []; private readonly Stack<StateDraft> _undo = []; private readonly Stack<StateDraft> _redo = []; private StateDraft _draft = new(); private StateDraft _original = new(); private IReadOnlyList<ActorResponse> _actors = []; private long _revision; private string _operationId = Guid.CreateVersion7().ToString("D"); private bool _loading = true, _dirty, _submitting, _conflict, _recovered, _staleDraft; private string? _loadError; private DefineStateLogicResponse? _committed;
    private static readonly StudioFieldDescriptor StateNameField=new("state-name","State name","The named state scope whose truth is being modeled.",true),CategoryField=new("state-category","State category","Keep domain, workflow, presentation, infrastructure, and observed truth distinct.",true),OwnerField=new("state-owner","State owner","The modeled actor accountable for this state scope.",true),StructureField=new("state-structure","State structure","One typed field name per line.",true),ValuesField=new("state-values","State values","Known values or phases, one per line.",false),FactNameField=new("fact-name","Fact name","A proposition whose authority is explicit.",true),FactTypeField=new("fact-type","Fact value type","The fact's semantic value type.",true),MutabilityField=new("fact-mutability","Fact mutability","How the fact may change or be derived.",true),AuthorityField=new("fact-authority","Fact authority","Why this state scope owns the fact.",true),RuleNameField=new("rule-name","Rule name","The governing logic evaluated by the transition.",true),RuleKindField=new("rule-kind","Rule kind","Validation, eligibility, decision, derivation, calculation, or policy.",true),RuleOwnerField=new("rule-owner","Rule authority owner","The actor accountable for the rule.",true),RuleStatementField=new("rule-statement","Rule statement","The explicit condition or constraint.",true),InvariantNameField=new("invariant-name","Invariant name","A concise identity for what must always hold.",true),InvariantStatementField=new("invariant-statement","Invariant statement","The property that every accepted transition preserves.",true),FalsifierField=new("falsifying-example","Falsifying example","A concrete observation that would disprove the invariant.",true),ProofField=new("proof-expectation","Proof expectation","One required proof type or behavior per line.",true),TransitionNameField=new("transition-name","Transition name","The named state-changing behavior.",true),ResultsField=new("semantic-results","Semantic results","Name | Kind | Meaning, one unique kind per line.",true),ReasonField=new("state-reason","Change reason","Why this state packet is being committed.",true);
    protected override Task OnInitializedAsync()=>LoadAsync();
    private async Task LoadAsync(){_loading=true;_loadError=null;try{var model=await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model")??throw new InvalidOperationException("The model contract returned no content.");_revision=model.Project.Revision;_actors=model.Actors;_draft=new(){OwnerId=_actors.FirstOrDefault()?.Id??"",RuleAuthorityOwnerId=_actors.FirstOrDefault()?.Id??"",Reason="Define explicit state, logic, and semantic results."};_original=_draft.Copy();var saved=await Drafts.ReadAsync<StateDraft>(DraftKey);if(saved is not null){_draft=saved.Value;_operationId=saved.OperationId;_dirty=true;_recovered=true;_staleDraft=saved.BaseRevision!=_revision;}}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}
    private async Task Change(string field,string? value){var previous=_draft.Copy();typeof(StateDraft).GetProperty(field)!.SetValue(_draft,value??"");if(Same(previous,_draft))return;_undo.Push(previous);Trim(_undo);_redo.Clear();_dirty=true;await PersistAsync();}
    private async Task ResetAsync(){_draft=_original.Copy();_undo.Clear();_redo.Clear();_dirty=false;_recovered=false;_staleDraft=false;_serverErrors.Clear();_operationId=Guid.CreateVersion7().ToString("D");await Drafts.RemoveAsync(DraftKey);}
    private async Task UndoAsync(){if(_undo.Count==0)return;_redo.Push(_draft.Copy());_draft=_undo.Pop();await PersistOrRemoveAsync();}
    private async Task RedoAsync(){if(_redo.Count==0)return;_undo.Push(_draft.Copy());_draft=_redo.Pop();await PersistOrRemoveAsync();}
    private async Task CommitAsync(){if(!CanCommit||_staleDraft)return;_submitting=true;_serverErrors.Clear();_conflict=false;try{var body=new DefineStateLogicRequest(_draft.StateName,_draft.StateCategory,_draft.StateStructure,_draft.StateValues,_draft.OwnerId,_draft.FactName,_draft.FactValueType,_draft.FactAuthority,_draft.FactMutability,_draft.RuleName,_draft.RuleKind,_draft.RuleStatement,_draft.RuleAuthorityOwnerId,_draft.InvariantName,_draft.InvariantStatement,_draft.FalsifyingExample,_draft.ProofExpectation,_draft.SemanticResults,_draft.TransitionName,_draft.SourcePredicate,_draft.Trigger,_draft.TargetPredicate,_draft.Reason);using var request=new HttpRequestMessage(HttpMethod.Post,$"api/v1/projects/{ProjectId}/state-logic"){Content=JsonContent.Create(body)};request.Headers.TryAddWithoutValidation("If-Match",$"\"{_revision}\"");request.Headers.TryAddWithoutValidation("Idempotency-Key",_operationId);using var response=await Http.SendAsync(request);if(response.IsSuccessStatusCode){_committed=await response.Content.ReadFromJsonAsync<DefineStateLogicResponse>();_dirty=false;await Drafts.RemoveAsync(DraftKey);return;}_conflict=response.StatusCode==System.Net.HttpStatusCode.Conflict;var problem=await response.Content.ReadFromJsonAsync<ProjectProblemResponse>();_serverErrors.AddRange(problem?.Errors.SelectMany(x=>x.Value)??[$"The command returned {(int)response.StatusCode}."]);}catch(Exception ex){_serverErrors.Add(ex.Message);}finally{_submitting=false;}}
    private async Task RefreshRevisionAsync(){var model=await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model");if(model is null)return;_revision=model.Project.Revision;_operationId=Guid.CreateVersion7().ToString("D");_serverErrors.Clear();_conflict=false;_staleDraft=false;await PersistAsync();}
    private string DraftKey=>$"state:{ProjectId}:new";
    private Task PersistAsync()=>Drafts.WriteAsync(DraftKey,new BrowserDraft<StateDraft>(_revision,_operationId,DateTimeOffset.UtcNow,_draft)).AsTask();
    private async Task PersistOrRemoveAsync(){_dirty=!Same(_draft,_original);if(_dirty)await PersistAsync();else await Drafts.RemoveAsync(DraftKey);}
    private static bool Same(StateDraft left,StateDraft right)=>typeof(StateDraft).GetProperties().All(property=>Equals(property.GetValue(left),property.GetValue(right)));
    private static void Trim(Stack<StateDraft> values){if(values.Count<=50)return;var retained=values.Take(50).Reverse().ToArray();values.Clear();foreach(var value in retained)values.Push(value);}
    private IReadOnlyList<(string Name,string Kind,string Meaning)> ResultRows=>_draft.SemanticResults.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Select(x=>x.Split('|',3,StringSplitOptions.TrimEntries)).Where(x=>x.Length==3).Select(x=>(x[0],x[1],x[2])).ToArray();
    private IReadOnlyList<(string Order,string Kind,string Label,bool Ready)> Catalog=>[("01","State",Has(_draft.StateName)?_draft.StateName:"Untitled state",StateReady),("02","Fact",Has(_draft.FactName)?_draft.FactName:"Missing fact",FactReady),("03","Rule",Has(_draft.RuleName)?_draft.RuleName:"Missing rule",RuleReady),("04","Invariant",Has(_draft.InvariantName)?_draft.InvariantName:"Missing invariant",InvariantReady),("05","Transition",Has(_draft.TransitionName)?_draft.TransitionName:"Missing transition",TransitionReady)];
    private bool StateReady=>Has(_draft.StateName)&&Has(_draft.OwnerId)&&LineCount(_draft.StateStructure)>0;private bool FactReady=>Has(_draft.FactName)&&Has(_draft.FactValueType)&&Has(_draft.FactAuthority);private bool RuleReady=>Has(_draft.RuleName)&&Has(_draft.RuleAuthorityOwnerId)&&Has(_draft.RuleStatement);private bool InvariantReady=>Has(_draft.InvariantName)&&Has(_draft.InvariantStatement)&&Has(_draft.FalsifyingExample)&&ProofCount>0;private bool TransitionReady=>Has(_draft.TransitionName)&&Has(_draft.SourcePredicate)&&Has(_draft.Trigger)&&Has(_draft.TargetPredicate)&&ResultRows.Count>0;private int ReadinessCount=>Catalog.Count(x=>x.Ready);private bool CanCommit=>ReadinessCount==5&&Has(_draft.Reason);private int ProofCount=>LineCount(_draft.ProofExpectation);private string OwnerName=>_actors.FirstOrDefault(x=>x.Id==_draft.OwnerId)?.Name??"Missing";private string CategoryLabel=>_draft.StateCategory switch{"ApplicationWorkflow"=>"Application workflow","ExternalObserved"=>"External observed",_=>_draft.StateCategory};private static int LineCount(string value)=>value.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Length;private static bool Has(string value)=>!string.IsNullOrWhiteSpace(value);
    private sealed class StateDraft{public string StateName{get;set;}="";public string StateCategory{get;set;}="Domain";public string StateStructure{get;set;}="";public string StateValues{get;set;}="";public string OwnerId{get;set;}="";public string FactName{get;set;}="";public string FactValueType{get;set;}="";public string FactAuthority{get;set;}="";public string FactMutability{get;set;}="Transitioned";public string RuleName{get;set;}="";public string RuleKind{get;set;}="Validation";public string RuleStatement{get;set;}="";public string RuleAuthorityOwnerId{get;set;}="";public string InvariantName{get;set;}="";public string InvariantStatement{get;set;}="";public string FalsifyingExample{get;set;}="";public string ProofExpectation{get;set;}="";public string SemanticResults{get;set;}="";public string TransitionName{get;set;}="";public string SourcePredicate{get;set;}="";public string Trigger{get;set;}="";public string TargetPredicate{get;set;}="";public string Reason{get;set;}="";public StateDraft Copy()=>(StateDraft)MemberwiseClone();}
}

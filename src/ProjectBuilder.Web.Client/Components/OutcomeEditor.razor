@namespace ProjectBuilder.Web.Client.Components
@inject HttpClient Http
@inject BrowserDraftStore Drafts

<section id="outcome-editor-workspace" class="actor-editor outcome-editor" aria-labelledby="outcome-editor-heading" data-testid="outcome-editor">
    <EditorKeyboardShortcuts ScopeId="outcome-editor-workspace" Commit="CommitAsync" Undo="UndoAsync" Redo="RedoAsync" />
    <header class="actor-editor-header outcome-editor-header">
        <div><p class="eyebrow">Outcome contract workspace</p><h1 id="outcome-editor-heading">@(IsEditing ? "Edit outcome" : "Add an outcome")</h1><p>Connect a beneficiary to an observable change. Outputs and activities alone do not qualify.</p></div>
        <div class="draft-state" data-testid="outcome-draft-state"><span class="status-dot @(_dirty ? "staged" : "clean")"></span><strong>@(_dirty ? "Staged draft" : "Clean draft")</strong><small>@(_dirty ? $"{_changed.Count} fields changed" : "No local changes")</small></div>
    </header>

    @if (_loading) { <div class="editor-loading" role="status">Loading actors and current outcomes…</div> }
    else if (_loadError is not null) { <div class="error-summary" role="alert"><h2>Editor unavailable</h2><p>@_loadError</p><button class="secondary-action" @onclick="LoadAsync">Try again</button></div> }
    else if (_actors.Count == 0) { <section class="editor-empty-state" role="alert"><p class="eyebrow">Missing beneficiary</p><h2>An actor is required</h2><p>An outcome must benefit a modeled actor. Add the role first; no placeholder relation will be invented.</p><a class="primary-action" href="/projects/@ProjectId/actors/new">Add actor</a></section> }
    else if (_committed is not null)
    {
        <div class="editor-commit-success" role="status" data-testid="outcome-committed"><p class="eyebrow">Revision @_committed.Revision committed</p><h2>@_committed.Outcome.Name @(IsEditing ? "updated" : "added")</h2><p><strong>@_committed.Outcome.BeneficiaryName</strong> benefits from this outcome. Knowledge state: <strong>@Label(_committed.Outcome.KnowledgeStatus)</strong>.</p><p>@_committed.AllowedNextAction</p><div class="editor-actions"><a class="primary-action" href="/projects/@ProjectId">Review project model</a><a class="secondary-action" href="/projects/@ProjectId/outcomes/new">Add another outcome</a></div></div>
    }
    else
    {
        @if (_recovered) { <div class="draft-recovery @(_staleDraft ? "stale" : null)" role="status" data-testid="outcome-draft-recovered"><div><p class="eyebrow">Browser-local recovery</p><strong>@(_staleDraft ? "Outcome draft is based on an earlier revision" : "Outcome draft restored after refresh")</strong><p>The beneficiary relation preview remains local until the typed command commits.</p></div>@if (_staleDraft) { <button class="secondary-action" type="button" @onclick="RefreshRevisionAsync">Use latest revision and keep draft</button> }</div> }
        <div class="actor-editor-layout">
            <form class="actor-definition-canvas" @onsubmit="CommitAsync" @onsubmit:preventDefault>
                @if (_serverErrors.Count > 0) { <div class="error-summary" role="alert"><h2>Command rejected</h2><ul>@foreach (var error in _serverErrors) { <li>@error</li> }</ul>@if (_conflict) { <button class="secondary-action" type="button" @onclick="RefreshRevisionAsync">Refresh revision and keep draft</button> }</div> }
                @if (DuplicateOutcomes.Count > 0)
                {
                    <aside class="duplicate-suggestions" aria-labelledby="outcome-duplicates-heading" data-testid="outcome-duplicates"><div><p class="eyebrow">Possible overlap</p><h2 id="outcome-duplicates-heading">Compare existing outcomes</h2><p>Matching language may express the same observable change. Review it before adding another claim.</p></div><ul>@foreach (var outcome in DuplicateOutcomes) { <li><strong>@outcome.Name</strong><span>@outcome.Statement</span><a href="/projects/@ProjectId?selected=@outcome.Id">Open in Explorer</a></li> }</ul></aside>
                }
                <section class="editor-section" aria-labelledby="outcome-identity-heading"><div class="section-marker">01</div><div class="section-body"><h2 id="outcome-identity-heading">Outcome identity</h2><p>Name the changed condition and make uncertainty explicit.</p>
                    <StudioField Descriptor="NameField" Finding="@NameFinding"><input id="outcome-name" value="@_draft.Name" @oninput="e => Change(nameof(_draft.Name), e.Value?.ToString() ?? string.Empty)" maxlength="500" /></StudioField>
                    <StudioField Descriptor="KnowledgeField"><select id="outcome-knowledge" value="@_draft.KnowledgeStatus" @onchange="e => Change(nameof(_draft.KnowledgeStatus), e.Value?.ToString() ?? string.Empty)" data-testid="outcome-knowledge"><option value="known">Known</option><option value="unknown">Unknown</option><option value="assumed">Assumed</option><option value="deferred">Deferred</option><option value="disputed">Disputed</option><option value="notApplicable">Not applicable</option></select></StudioField>
                </div></section>
                <section class="editor-section" aria-labelledby="beneficiary-heading"><div class="section-marker">02</div><div class="section-body"><h2 id="beneficiary-heading">Who benefits</h2><p>Select who experiences the changed condition; this commits a typed <code>benefitsFrom</code> relation.</p>
                    <StudioField Descriptor="BeneficiaryField"><select id="outcome-beneficiary" value="@_draft.BeneficiaryActorId" @onchange="e => Change(nameof(_draft.BeneficiaryActorId), e.Value?.ToString() ?? string.Empty)">@foreach (var actor in _actors) { <option value="@actor.Id">@actor.Name</option> }</select></StudioField>
                    @if (SelectedActor is not null) { <div class="relation-preview" data-testid="beneficiary-relation"><div class="relation-node"><span>Actor</span><strong>@SelectedActor.Name</strong><small>@SelectedActor.ContextualRole</small></div><div class="relation-edge"><span aria-hidden="true">→</span><strong>benefits from</strong></div><div class="relation-node pending"><span>Outcome</span><strong>@(Has(_draft.Name) ? _draft.Name : "Draft outcome")</strong><small>Committed with this change set</small></div></div> }
                </div></section>
                <section class="editor-section" aria-labelledby="observable-heading"><div class="section-marker">03</div><div class="section-body"><h2 id="observable-heading">Observable change</h2><p>State what becomes true and how a reviewer could recognize it.</p>
                    <StudioField Descriptor="StatementField" Finding="@StatementFinding"><textarea id="outcome-statement" value="@_draft.Statement" @oninput="e => Change(nameof(_draft.Statement), e.Value?.ToString() ?? string.Empty)" rows="4" maxlength="20000"></textarea></StudioField>
                    <StudioField Descriptor="SignalsField" Finding="@SignalsFinding"><textarea id="success-signals" value="@_draft.SuccessSignals" @oninput="e => Change(nameof(_draft.SuccessSignals), e.Value?.ToString() ?? string.Empty)" rows="5"></textarea></StudioField>
                </div></section>
                <section class="editor-section" aria-labelledby="outcome-review-heading"><div class="section-marker">04</div><div class="section-body"><h2 id="outcome-review-heading">Review & provenance</h2><p>Inspect the semantic operation before it crosses the commit boundary.</p>
                    <div class="source-gap"><span>Staged operations</span><strong>@(IsEditing ? "Outcome updated + beneficiary relation updated" : "Outcome added + beneficiary relation added")</strong><p>Both operations advance the project by exactly one revision in one transaction.</p><a href="/api/v1/projects/@ProjectId/model">Inspect runtime contract</a> · <a href="/projects/@ProjectId#history-heading">Open change history</a></div>
                    <StudioField Descriptor="ReasonField" Finding="@ReasonFinding"><input id="outcome-reason" value="@_draft.Reason" @oninput="e => Change(nameof(_draft.Reason), e.Value?.ToString() ?? string.Empty)" maxlength="2000" /></StudioField>
                    @if (_draft.KnowledgeStatus is not "known") { <div class="knowledge-notice" role="note"><strong>@Label(_draft.KnowledgeStatus) is explicit.</strong> Explain its basis in the change reason until structured knowledge provenance is owned.</div> }
                </div></section>
                <div class="editor-command-bar"><div><span>Command</span><code>@(IsEditing ? "projectbuilder.element.update.outcome" : "projectbuilder.element.create.outcome")</code><small>Expected revision @_revision · two operations · Ctrl+S commit</small></div><div class="editor-actions"><button class="icon-action" data-testid="outcome-undo" type="button" @onclick="UndoAsync" disabled="@(_undo.Count == 0 || _submitting)">↶ <span>Undo</span></button><button class="icon-action" data-testid="outcome-redo" type="button" @onclick="RedoAsync" disabled="@(_redo.Count == 0 || _submitting)">↷ <span>Redo</span></button><button class="secondary-action" type="button" @onclick="ResetAsync" disabled="@(!_dirty || _submitting)">Discard draft</button><button class="primary-action" type="submit" disabled="@(!CanCommit || _submitting || _staleDraft)">@(_submitting ? "Committing…" : (IsEditing ? "Commit outcome update" : "Commit outcome"))</button></div></div>
            </form>
            <aside class="editor-inspector" aria-labelledby="outcome-readiness-heading"><p class="eyebrow">Outcome test</p><h2 id="outcome-readiness-heading">Is the change observable?</h2><div class="outcome-equation" aria-label="Outcome definition equation"><span>@(SelectedActor?.Name ?? "Actor")</span><b>+</b><span>@(Has(_draft.Statement) ? "observable change" : "missing change")</span><b>+</b><span>@(SignalCount > 0 ? $"{SignalCount} signal(s)" : "missing signals")</span></div><div class="readiness-score"><strong>@ReadinessCount/4</strong><span>outcome facts ready</span></div><ul class="readiness-list"><li class="@(Has(_draft.Name) ? "ready" : null)">Outcome named</li><li class="@(Has(_draft.BeneficiaryActorId) ? "ready" : null)">Beneficiary linked</li><li class="@(Has(_draft.Statement) ? "ready" : null)">Change observable</li><li class="@(SignalCount > 0 ? "ready" : null)">Signals supplied</li></ul><hr/><dl class="command-facts"><div><dt>Revision</dt><dd>@_revision</dd></div><div><dt>Knowledge</dt><dd>@Label(_draft.KnowledgeStatus)</dd></div><div><dt>Relations</dt><dd>1 pending</dd></div></dl><p class="inspector-note">The relation preview is a draft projection. It becomes semantic truth only if the command commits.</p></aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;
    [Parameter] public string? OutcomeId { get; set; }
    private readonly HashSet<string> _changed = []; private readonly List<string> _serverErrors = []; private readonly Stack<OutcomeDraft> _undo = []; private readonly Stack<OutcomeDraft> _redo = [];
    private OutcomeDraft _draft = new(); private OutcomeDraft _original = new(); private IReadOnlyList<ActorResponse> _actors = []; private IReadOnlyList<OutcomeResponse> _outcomes = []; private long _revision; private string _operationId = Guid.CreateVersion7().ToString("D"); private bool _loading = true; private bool _submitting; private bool _dirty; private bool _conflict; private bool _recovered; private bool _staleDraft; private string? _loadError; private AddOutcomeResponse? _committed;
    private static readonly StudioFieldDescriptor NameField = new("outcome-name", "Outcome name", "A concise name for the beneficiary's changed condition.", true);
    private static readonly StudioFieldDescriptor KnowledgeField = new("outcome-knowledge", "Knowledge state", "Distinguish verified intent from unknown, assumed, deferred, or disputed meaning.", true);
    private static readonly StudioFieldDescriptor BeneficiaryField = new("outcome-beneficiary", "Beneficiary", "The actor who experiences the value or changed condition.", true);
    private static readonly StudioFieldDescriptor StatementField = new("outcome-statement", "Observable outcome statement", "Describe what becomes possible or true for the beneficiary.", true);
    private static readonly StudioFieldDescriptor SignalsField = new("success-signals", "Success signals", "One observable indication per line; these are not implementation tasks.", true);
    private static readonly StudioFieldDescriptor ReasonField = new("outcome-reason", "Change reason", "Why this outcome and relation are being committed.", true);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; _loadError = null; try { var model = await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model"); if (model is null) throw new InvalidOperationException("The model contract returned no content."); _revision = model.Project.Revision; _actors = model.Actors; _outcomes = model.Outcomes; if (IsEditing) { var outcome = model.Outcomes.FirstOrDefault(value => value.Id == OutcomeId) ?? throw new InvalidOperationException("The selected outcome is no longer available."); _draft = From(outcome); } else _draft = new() { BeneficiaryActorId = _actors.FirstOrDefault()?.Id ?? "", Reason = "Define an observable project outcome." }; _original = _draft.Copy(); var saved = await Drafts.ReadAsync<OutcomeDraft>(DraftKey); if (saved is not null) { _draft = saved.Value; _operationId = saved.OperationId; _dirty = true; _recovered = true; _staleDraft = saved.BaseRevision != _revision; RecalculateChanged(); } } catch (Exception ex) { _loadError = ex.Message; } finally { _loading = false; } }
    private async Task Change(string field, string value) { var previous = _draft.Copy(); typeof(OutcomeDraft).GetProperty(field)!.SetValue(_draft, value); if (Same(previous, _draft)) return; _undo.Push(previous); Trim(_undo); _redo.Clear(); _changed.Add(field); _dirty = true; await PersistAsync(); }
    private async Task ResetAsync() { _draft = _original.Copy(); _changed.Clear(); _undo.Clear(); _redo.Clear(); _dirty = false; _recovered = false; _staleDraft = false; _serverErrors.Clear(); _operationId = Guid.CreateVersion7().ToString("D"); await Drafts.RemoveAsync(DraftKey); }
    private async Task UndoAsync() { if (_undo.Count == 0) return; _redo.Push(_draft.Copy()); _draft = _undo.Pop(); RecalculateChanged(); await PersistOrRemoveAsync(); }
    private async Task RedoAsync() { if (_redo.Count == 0) return; _undo.Push(_draft.Copy()); _draft = _redo.Pop(); RecalculateChanged(); await PersistOrRemoveAsync(); }
    private async Task CommitAsync() { if (!CanCommit || _staleDraft) return; _submitting = true; _serverErrors.Clear(); _conflict = false; try { var method = IsEditing ? HttpMethod.Put : HttpMethod.Post; var path = IsEditing ? $"api/v1/projects/{ProjectId}/outcomes/{OutcomeId}" : $"api/v1/projects/{ProjectId}/outcomes"; HttpContent content = IsEditing ? JsonContent.Create(new UpdateOutcomeRequest(_draft.Name, _draft.Statement, _draft.SuccessSignals, _draft.BeneficiaryActorId, _draft.Reason, _draft.KnowledgeStatus)) : JsonContent.Create(new AddOutcomeRequest(_draft.Name, _draft.Statement, _draft.SuccessSignals, _draft.BeneficiaryActorId, _draft.Reason, _draft.KnowledgeStatus)); using var request = new HttpRequestMessage(method, path) { Content = content }; request.Headers.TryAddWithoutValidation("If-Match", $"\"{_revision}\""); request.Headers.TryAddWithoutValidation("Idempotency-Key", _operationId); using var response = await Http.SendAsync(request); if (response.IsSuccessStatusCode) { if (IsEditing) { var updated = await response.Content.ReadFromJsonAsync<UpdateOutcomeResponse>(); _committed = updated is null ? null : new(updated.Outcome, updated.Revision, updated.AllowedNextAction); } else _committed = await response.Content.ReadFromJsonAsync<AddOutcomeResponse>(); _dirty = false; _changed.Clear(); await Drafts.RemoveAsync(DraftKey); return; } _conflict = response.StatusCode == System.Net.HttpStatusCode.Conflict; var problem = await response.Content.ReadFromJsonAsync<ProjectProblemResponse>(); _serverErrors.AddRange(problem?.Errors.SelectMany(x => x.Value) ?? [$"The command returned {(int)response.StatusCode}."]); } catch (Exception ex) { _serverErrors.Add(ex.Message); } finally { _submitting = false; } }
    private async Task RefreshRevisionAsync() { var model = await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model"); if (model is null) return; _revision = model.Project.Revision; _operationId = Guid.CreateVersion7().ToString("D"); _serverErrors.Clear(); _conflict = false; _staleDraft = false; await PersistAsync(); }
    private string DraftKey => $"outcome:{ProjectId}:{(IsEditing ? OutcomeId : "new")}";
    private Task PersistAsync() => Drafts.WriteAsync(DraftKey, new BrowserDraft<OutcomeDraft>(_revision, _operationId, DateTimeOffset.UtcNow, _draft)).AsTask();
    private async Task PersistOrRemoveAsync() { _dirty = !Same(_draft, _original); if (_dirty) await PersistAsync(); else await Drafts.RemoveAsync(DraftKey); }
    private void RecalculateChanged() { _changed.Clear(); foreach (var property in typeof(OutcomeDraft).GetProperties()) if (!Equals(property.GetValue(_draft), property.GetValue(_original))) _changed.Add(property.Name); _dirty = _changed.Count > 0; }
    private static bool Same(OutcomeDraft left, OutcomeDraft right) => typeof(OutcomeDraft).GetProperties().All(property => Equals(property.GetValue(left), property.GetValue(right)));
    private static void Trim(Stack<OutcomeDraft> values) { if (values.Count <= 50) return; var retained = values.Take(50).Reverse().ToArray(); values.Clear(); foreach (var value in retained) values.Push(value); }
    private ActorResponse? SelectedActor => _actors.FirstOrDefault(actor => actor.Id == _draft.BeneficiaryActorId);
    private IReadOnlyList<OutcomeResponse> DuplicateOutcomes { get { var term = _draft.Name.Trim(); if (term.Length < 3) return []; return _outcomes.Where(outcome => outcome.Id != OutcomeId && (outcome.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || term.Contains(outcome.Name, StringComparison.OrdinalIgnoreCase))).Take(3).ToArray(); } }
    private int SignalCount => _draft.SuccessSignals.Split(['\r','\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;
    private bool CanCommit => Has(_draft.Name) && Has(_draft.BeneficiaryActorId) && Has(_draft.Statement) && SignalCount > 0 && Has(_draft.Reason);
    private int ReadinessCount => (Has(_draft.Name) ? 1 : 0) + (Has(_draft.BeneficiaryActorId) ? 1 : 0) + (Has(_draft.Statement) ? 1 : 0) + (SignalCount > 0 ? 1 : 0);
    private static bool Has(string value) => !string.IsNullOrWhiteSpace(value); private string? Required(string value, string message) => _dirty && !Has(value) ? message : null;
    private string? NameFinding => Required(_draft.Name, "Outcome name is required."); private string? StatementFinding => Required(_draft.Statement, "Describe the observable change."); private string? SignalsFinding => _dirty && SignalCount == 0 ? "Add at least one observable success signal." : null; private string? ReasonFinding => Required(_draft.Reason, "A change reason is required.");
    private static string Label(string value) => value switch { "notApplicable" => "Not applicable", _ => string.Concat(value[..1].ToUpperInvariant(), value.AsSpan(1)) };
    private bool IsEditing => !string.IsNullOrWhiteSpace(OutcomeId);
    private static OutcomeDraft From(OutcomeResponse outcome) => new() { Name = outcome.Name, KnowledgeStatus = outcome.KnowledgeStatus, BeneficiaryActorId = outcome.BeneficiaryActorId, Statement = outcome.Statement, SuccessSignals = string.Join('\n', outcome.SuccessSignals), Reason = "Update the observable project outcome." };
    private sealed class OutcomeDraft { public string Name { get; set; } = ""; public string KnowledgeStatus { get; set; } = "known"; public string BeneficiaryActorId { get; set; } = ""; public string Statement { get; set; } = ""; public string SuccessSignals { get; set; } = ""; public string Reason { get; set; } = ""; public OutcomeDraft Copy() => (OutcomeDraft)MemberwiseClone(); }
}

@namespace ProjectBuilder.Web.Client.Components
@inject HttpClient Http
@inject BrowserDraftStore Drafts

<section id="path-recovery-workspace" class="path-studio" aria-labelledby="path-studio-heading" data-testid="path-studio">
    <EditorKeyboardShortcuts ScopeId="path-recovery-workspace" Commit="CommitAsync" Undo="UndoAsync" Redo="RedoAsync" />
    <header class="path-studio-header">
        <div><p class="eyebrow">Recovery lens · typed path topology</p><h1 id="path-studio-heading">Define a branch and recovery path</h1><p>Connect a falsifiable entry condition to ordered behavior, participant observation, terminal state, intended effect, and an owned route back to safety.</p></div>
        <div class="draft-state"><span class="status-dot @(_dirty ? "staged" : "clean")"></span><strong>@(_dirty ? "Staged recovery model" : "Clean draft")</strong><small>@ReadinessCount/6 topology groups ready</small></div>
    </header>
    @if (_loading) { <div class="editor-loading" role="status">Loading scenario, state, and participant contracts…</div> }
    else if (_loadError is not null) { <div class="error-summary" role="alert"><h2>Recovery lens unavailable</h2><p>@_loadError</p><button class="secondary-action" @onclick="LoadAsync">Try again</button></div> }
    else if (_model is null || _model.Narratives.Count == 0 || _model.StateLogic.Count == 0 || _model.Actors.Count == 0) { <div class="editor-empty-state" role="alert"><p class="eyebrow">Prerequisites incomplete</p><h2>Behavior, state, and ownership are required</h2><p>Define a scenario, state transition with results, and actor before connecting a recovery path. No placeholder references are invented.</p><a class="primary-action" href="/projects/@ProjectId">Return to project cockpit</a></div> }
    else if (_committed is not null) { <div class="editor-commit-success" role="status" data-testid="path-committed"><p class="eyebrow">Revision @_committed.Revision committed</p><h2>@_committed.Path.BranchName defined</h2><p>@_committed.Path.BranchClassification branch → @_committed.Path.RecoveryStrategy recovery. @_committed.AllowedNextAction</p><div class="editor-actions"><a class="primary-action" href="/projects/@ProjectId">Review paths</a><a class="secondary-action" href="/projects/@ProjectId/history">Inspect semantic diff</a></div></div> }
    else
    {
        @if (_recovered) { <div class="draft-recovery @(_staleDraft ? "stale" : null)" role="status" data-testid="path-draft-recovered"><div><p class="eyebrow">Browser-local recovery</p><strong>@(_staleDraft ? "Recovery draft is based on an earlier revision" : "Recovery draft restored after refresh")</strong><p>The topology remains a local projection until its typed command commits.</p></div>@if (_staleDraft) { <button class="secondary-action" type="button" @onclick="RefreshRevisionAsync">Use latest revision and keep draft</button> }</div> }
        <div class="path-studio-layout">
            <aside class="path-catalog" aria-labelledby="path-catalog-heading"><p class="eyebrow">Topology outline</p><h2 id="path-catalog-heading">Branch packet</h2><ol>@foreach (var node in Nodes) { <li class="@(node.Ready ? "ready" : null)"><span>@node.Order</span><div><strong>@node.Kind</strong><small>@node.Label</small></div><i>@(node.Ready ? "Ready" : "Missing")</i></li> }</ol><p class="inspector-note">The outline and connectors are projections. Only the typed expected-revision command changes canonical truth.</p></aside>
            <form class="path-canvas" @onsubmit="CommitAsync" @onsubmit:preventDefault>
                @if (_serverErrors.Count > 0) { <div class="error-summary" role="alert"><h2>Path command rejected</h2><ul>@foreach (var error in _serverErrors) { <li>@error</li> }</ul>@if (_conflict) { <button class="secondary-action" type="button" @onclick="RefreshRevisionAsync">Refresh revision and keep draft</button> }</div> }
                <section class="path-scope-node" aria-labelledby="path-scope-heading"><div class="path-node-heading"><span>01</span><div><p>Source semantics</p><h2 id="path-scope-heading">Scope and ownership</h2></div><strong class="node-chip">@OwnerName</strong></div><div class="path-field-grid three"><StudioField Descriptor="ScenarioField"><select id="path-scenario" value="@_draft.ScenarioId" @onchange="e => Change(nameof(_draft.ScenarioId), e.Value?.ToString())">@foreach (var narrative in _model.Narratives) { <option value="@narrative.ScenarioId">@narrative.ScenarioName</option> }</select></StudioField><StudioField Descriptor="TransitionField"><select id="path-transition" value="@_draft.SourceTransitionId" @onchange="e => Change(nameof(_draft.SourceTransitionId), e.Value?.ToString())">@foreach (var state in _model.StateLogic) { <option value="@state.TransitionId">@state.TransitionName</option> }</select></StudioField><StudioField Descriptor="OwnerField"><select id="path-owner" value="@_draft.OwnerId" @onchange="e => Change(nameof(_draft.OwnerId), e.Value?.ToString())">@foreach (var actor in _model.Actors) { <option value="@actor.Id">@actor.Name</option> }</select></StudioField></div></section>
                <div class="path-flow" data-testid="path-topology">
                    <section class="path-node condition-node" aria-labelledby="condition-heading"><div class="path-node-heading"><span>02</span><div><p>Falsifiable gate</p><h2 id="condition-heading">Branch condition</h2></div><strong class="node-chip">@_draft.BranchConditionKind</strong></div><div class="path-field-grid two"><StudioField Descriptor="BranchNameField"><input id="branch-name" value="@_draft.BranchName" @oninput="e => Change(nameof(_draft.BranchName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="ClassificationField"><select id="branch-classification" value="@_draft.BranchClassification" @onchange="e => Change(nameof(_draft.BranchClassification), e.Value?.ToString())"><option>Alternate</option><option>Exceptional</option><option>Degraded</option><option>Cancellation</option><option>Compensation</option></select></StudioField><StudioField Descriptor="ConditionNameField"><input id="condition-name" value="@_draft.BranchConditionName" @oninput="e => Change(nameof(_draft.BranchConditionName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="ConditionKindField"><select id="condition-kind" value="@_draft.BranchConditionKind" @onchange="e => Change(nameof(_draft.BranchConditionKind), e.Value?.ToString())"><option>Entry</option><option>Guard</option><option>Branch</option><option>Exit</option><option>Cancellation</option></select></StudioField></div><StudioField Descriptor="ConditionStatementField"><textarea id="condition-statement" rows="3" value="@_draft.BranchCondition" @oninput="e => Change(nameof(_draft.BranchCondition), e.Value?.ToString())"></textarea></StudioField><div class="binding-strip"><span>Bound truth</span><strong>@(SelectedState?.FactName ?? "Missing fact")</strong><i>+</i><strong>@(SelectedState?.RuleName ?? "Missing rule")</strong></div></section>
                    <div class="path-connector"><span aria-hidden="true">→</span><small>when true</small></div>
                    <section class="path-node behavior-node" aria-labelledby="branch-behavior-heading"><div class="path-node-heading"><span>03</span><div><p>Ordered behavior</p><h2 id="branch-behavior-heading">Branch execution</h2></div><strong class="node-chip">@BranchSegmentCount steps</strong></div><StudioField Descriptor="BranchSegmentsField"><textarea id="branch-segments" rows="5" value="@_draft.BranchSegments" @oninput="e => Change(nameof(_draft.BranchSegments), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="BranchStateField"><textarea id="branch-state" rows="3" value="@_draft.BranchTerminalState" @oninput="e => Change(nameof(_draft.BranchTerminalState), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="BranchObservationField"><textarea id="branch-observation" rows="3" value="@_draft.BranchObservation" @oninput="e => Change(nameof(_draft.BranchObservation), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="TerminalResultField"><select id="path-result" value="@_draft.TerminalResultId" @onchange="e => Change(nameof(_draft.TerminalResultId), e.Value?.ToString())">@foreach (var result in AvailableResults) { <option value="@result.Id">@result.Name (@result.Kind)</option> }</select></StudioField></section>
                </div>
                <section class="effect-bridge"><div class="path-node-heading"><span>04</span><div><p>Observable consequence</p><h2 id="effect-heading">Intended effect</h2></div><strong class="node-chip">@_draft.EffectKind</strong></div><div class="path-field-grid three"><StudioField Descriptor="EffectNameField"><input id="effect-name" value="@_draft.EffectName" @oninput="e => Change(nameof(_draft.EffectName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="EffectKindField"><select id="effect-kind" value="@_draft.EffectKind" @onchange="e => Change(nameof(_draft.EffectKind), e.Value?.ToString())"><option>Observation</option><option>ExternalInteraction</option><option>DomainMutation</option><option>Audit</option><option>Notification</option><option>ManualIntervention</option></select></StudioField><StudioField Descriptor="EffectStatementField"><textarea id="effect-statement" rows="3" value="@_draft.EffectStatement" @oninput="e => Change(nameof(_draft.EffectStatement), e.Value?.ToString())"></textarea></StudioField></div></section>
                <section class="recovery-lane" aria-labelledby="recovery-heading"><div class="recovery-lane-title"><span>05</span><div><p>Owned route back to safety</p><h2 id="recovery-heading">Recovery path</h2></div><strong>@_draft.RecoveryStrategy</strong></div><div class="recovery-topology"><div><StudioField Descriptor="RecoveryNameField"><input id="recovery-name" value="@_draft.RecoveryName" @oninput="e => Change(nameof(_draft.RecoveryName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="RecoveryStrategyField"><select id="recovery-strategy" value="@_draft.RecoveryStrategy" @onchange="e => Change(nameof(_draft.RecoveryStrategy), e.Value?.ToString())"><option>CorrectAndRetry</option><option>Retry</option><option>Resume</option><option>Reconcile</option><option>Escalate</option><option>Compensate</option><option>SafeStop</option></select></StudioField></div><div><StudioField Descriptor="RecoveryConditionNameField"><input id="recovery-condition-name" value="@_draft.RecoveryConditionName" @oninput="e => Change(nameof(_draft.RecoveryConditionName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="RecoveryConditionField"><textarea id="recovery-condition" rows="3" value="@_draft.RecoveryCondition" @oninput="e => Change(nameof(_draft.RecoveryCondition), e.Value?.ToString())"></textarea></StudioField></div><div><StudioField Descriptor="RecoverySegmentsField"><textarea id="recovery-segments" rows="5" value="@_draft.RecoverySegments" @oninput="e => Change(nameof(_draft.RecoverySegments), e.Value?.ToString())"></textarea></StudioField></div><div><StudioField Descriptor="RecoveryResultField"><select id="recovery-result" value="@_draft.RecoveryResultId" @onchange="e => Change(nameof(_draft.RecoveryResultId), e.Value?.ToString())">@foreach (var result in AvailableResults) { <option value="@result.Id">@result.Name (@result.Kind)</option> }</select></StudioField><StudioField Descriptor="RecoveryStateField"><textarea id="recovery-state" rows="3" value="@_draft.RecoveryTerminalState" @oninput="e => Change(nameof(_draft.RecoveryTerminalState), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="RecoveryObservationField"><textarea id="recovery-observation" rows="3" value="@_draft.RecoveryObservation" @oninput="e => Change(nameof(_draft.RecoveryObservation), e.Value?.ToString())"></textarea></StudioField></div></div></section>
                <section class="resilience-panel" aria-labelledby="resilience-heading"><div class="path-node-heading"><span>06</span><div><p>Operational semantics</p><h2 id="resilience-heading">Retry, idempotency, and closure</h2></div><strong class="node-chip">Explicit policy</strong></div><div class="path-field-grid two"><StudioField Descriptor="RetryField"><textarea id="retry-policy" rows="3" value="@_draft.RetryPolicy" @oninput="e => Change(nameof(_draft.RetryPolicy), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="IdempotencyField"><textarea id="idempotency-analysis" rows="3" value="@_draft.IdempotencyAnalysis" @oninput="e => Change(nameof(_draft.IdempotencyAnalysis), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ExitField"><textarea id="exit-condition" rows="2" value="@_draft.ExitCondition" @oninput="e => Change(nameof(_draft.ExitCondition), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ReconciliationField"><textarea id="reconciliation" rows="2" value="@_draft.Reconciliation" @oninput="e => Change(nameof(_draft.Reconciliation), e.Value?.ToString())"></textarea></StudioField></div><StudioField Descriptor="ReasonField"><input id="path-reason" value="@_draft.Reason" @oninput="e => Change(nameof(_draft.Reason), e.Value?.ToString())" /></StudioField></section>
                <div class="editor-command-bar"><div><span>Command</span><code>projectbuilder.path.define</code><small>Expected revision @_revision · five typed operations · Ctrl+S commit</small></div><div class="editor-actions"><button class="icon-action" data-testid="path-undo" type="button" @onclick="UndoAsync" disabled="@(_undo.Count == 0 || _submitting)">↶ <span>Undo</span></button><button class="icon-action" data-testid="path-redo" type="button" @onclick="RedoAsync" disabled="@(_redo.Count == 0 || _submitting)">↷ <span>Redo</span></button><button class="secondary-action" type="button" @onclick="ResetAsync" disabled="@(!_dirty || _submitting)">Discard draft</button><button class="primary-action" type="submit" disabled="@(!CanCommit || _submitting || _staleDraft)">@(_submitting ? "Committing…" : "Commit branch and recovery")</button></div></div>
            </form>
            <aside class="path-inspector" aria-labelledby="path-readiness-heading"><p class="eyebrow">Recovery inspector</p><h2 id="path-readiness-heading">Closure readiness</h2><div class="readiness-score"><strong>@ReadinessCount/6</strong><span>groups ready</span></div><dl><div><dt>Scenario</dt><dd>@(SelectedNarrative?.ScenarioName ?? "Missing")</dd></div><div><dt>Transition</dt><dd>@(SelectedState?.TransitionName ?? "Missing")</dd></div><div><dt>Owner</dt><dd>@OwnerName</dd></div><div><dt>Branch result</dt><dd>@ResultName(_draft.TerminalResultId)</dd></div><div><dt>Recovery result</dt><dd>@ResultName(_draft.RecoveryResultId)</dd></div><div><dt>Segments</dt><dd>@BranchSegmentCount + @RecoverySegmentCount</dd></div></dl><hr/><p class="inspector-note">External effects describe intent, never provider calls. Recovery is incomplete until its observation and terminal state are explicit.</p></aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;
    private readonly List<string> _serverErrors = []; private readonly Stack<PathDraft> _undo = []; private readonly Stack<PathDraft> _redo = [];
    private ProjectModelResponse? _model; private PathDraft _draft = new(); private PathDraft _original = new(); private long _revision; private string _operationId = Guid.CreateVersion7().ToString("D"); private bool _loading = true, _dirty, _submitting, _conflict, _recovered, _staleDraft; private string? _loadError; private DefinePathResponse? _committed;
    private static readonly StudioFieldDescriptor ScenarioField = new("path-scenario", "Scenario", "The modeled path this branch refines.", true); private static readonly StudioFieldDescriptor TransitionField = new("path-transition", "Source transition", "The explicit transition whose fact, rule, and results govern this path.", true); private static readonly StudioFieldDescriptor OwnerField = new("path-owner", "Recovery owner", "The actor accountable for recovery.", true);
    private static readonly StudioFieldDescriptor BranchNameField = new("branch-name", "Branch name", "A stable name for the alternate, exceptional, degraded, cancellation, or compensation path.", true); private static readonly StudioFieldDescriptor ClassificationField = new("branch-classification", "Classification", "How this path differs from the primary scenario.", true); private static readonly StudioFieldDescriptor ConditionNameField = new("condition-name", "Condition name *", "A concise falsifiable gate."); private static readonly StudioFieldDescriptor ConditionKindField = new("condition-kind", "Condition kind", "Where the condition governs path execution.", true); private static readonly StudioFieldDescriptor ConditionStatementField = new("condition-statement", "Condition statement", "The semantic predicate that selects this branch.", true);
    private static readonly StudioFieldDescriptor BranchSegmentsField = new("branch-segments", "Ordered branch segments", "One observable or semantic segment per line.", true); private static readonly StudioFieldDescriptor BranchStateField = new("branch-state", "State at branch termination", "What is true when branch execution stops.", true); private static readonly StudioFieldDescriptor BranchObservationField = new("branch-observation", "Participant observation", "What a participant can perceive at branch termination.", true); private static readonly StudioFieldDescriptor TerminalResultField = new("path-result", "Branch terminal result", "A typed result owned by the source transition.", true);
    private static readonly StudioFieldDescriptor EffectNameField = new("effect-name", "Effect name", "The named consequence produced by the branch.", true); private static readonly StudioFieldDescriptor EffectKindField = new("effect-kind", "Effect kind", "Classifies the consequence without selecting a provider.", true); private static readonly StudioFieldDescriptor EffectStatementField = new("effect-statement", "Intended effect", "The observable or semantic consequence.", true);
    private static readonly StudioFieldDescriptor RecoveryNameField = new("recovery-name", "Recovery path name", "A stable name for the route back to safety.", true); private static readonly StudioFieldDescriptor RecoveryStrategyField = new("recovery-strategy", "Recovery strategy", "The governing recovery approach.", true); private static readonly StudioFieldDescriptor RecoveryConditionNameField = new("recovery-condition-name", "Recovery condition name", "The named gate into recovery.", true); private static readonly StudioFieldDescriptor RecoveryConditionField = new("recovery-condition", "Recovery entry condition", "What must be true before recovery begins.", true); private static readonly StudioFieldDescriptor RecoverySegmentsField = new("recovery-segments", "Ordered recovery segments", "One recovery action per line.", true); private static readonly StudioFieldDescriptor RecoveryResultField = new("recovery-result", "Recovery terminal result", "The typed result reached by recovery.", true); private static readonly StudioFieldDescriptor RecoveryStateField = new("recovery-state", "State at recovery termination", "What is true after recovery finishes.", true); private static readonly StudioFieldDescriptor RecoveryObservationField = new("recovery-observation", "Recovery observation", "What proves recovery to the participant.", true);
    private static readonly StudioFieldDescriptor RetryField = new("retry-policy", "Retry policy", "When another attempt is permitted and when it stops."); private static readonly StudioFieldDescriptor IdempotencyField = new("idempotency-analysis", "Idempotency analysis", "How repeated intent avoids duplicate semantic effects."); private static readonly StudioFieldDescriptor ExitField = new("exit-condition", "Exit condition", "When the recovery loop terminates."); private static readonly StudioFieldDescriptor ReconciliationField = new("reconciliation", "Reconciliation", "How partial or observed effects become consistent."); private static readonly StudioFieldDescriptor ReasonField = new("path-reason", "Change reason", "Why this path packet should enter canonical history.", true);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync(){_loading=true;_loadError=null;try{_model=await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model")??throw new InvalidOperationException("The model contract returned no content.");_revision=_model.Project.Revision;if(_model.Narratives.Count>0&&_model.StateLogic.Count>0&&_model.Actors.Count>0){var state=_model.StateLogic[0];_draft=new(){ScenarioId=_model.Narratives[0].ScenarioId,SourceTransitionId=state.TransitionId,OwnerId=_model.Actors[0].Id,TerminalResultId=state.Results.FirstOrDefault(x=>x.Kind!="success")?.Id??state.Results[0].Id,RecoveryResultId=state.Results.FirstOrDefault(x=>x.Kind=="success")?.Id??state.Results[0].Id,Reason="Define an explicit branch and recovery path."};_original=_draft.Copy();var saved=await Drafts.ReadAsync<PathDraft>(DraftKey);if(saved is not null){_draft=saved.Value;_operationId=saved.OperationId;_dirty=true;_recovered=true;_staleDraft=saved.BaseRevision!=_revision;}}}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}
    private async Task Change(string field,string? value){var previous=_draft.Copy();typeof(PathDraft).GetProperty(field)!.SetValue(_draft,value??"");if(Same(previous,_draft))return;_undo.Push(previous);Trim(_undo);_redo.Clear();_dirty=true;await PersistAsync();}
    private async Task UndoAsync(){if(_undo.Count==0)return;_redo.Push(_draft.Copy());_draft=_undo.Pop();await PersistOrRemoveAsync();}private async Task RedoAsync(){if(_redo.Count==0)return;_undo.Push(_draft.Copy());_draft=_redo.Pop();await PersistOrRemoveAsync();}private async Task ResetAsync(){_draft=_original.Copy();_undo.Clear();_redo.Clear();_dirty=false;_recovered=false;_staleDraft=false;_serverErrors.Clear();_operationId=Guid.CreateVersion7().ToString("D");await Drafts.RemoveAsync(DraftKey);}
    private async Task CommitAsync(){if(!CanCommit||_staleDraft)return;_submitting=true;_serverErrors.Clear();_conflict=false;try{var state=SelectedState!;var body=new DefinePathRequest(_draft.ScenarioId,_draft.SourceTransitionId,_draft.TerminalResultId,_draft.RecoveryResultId,_draft.OwnerId,_draft.BranchName,_draft.BranchClassification,_draft.BranchConditionName,_draft.BranchConditionKind,_draft.BranchCondition,state.FactId,state.RuleId,_draft.BranchSegments,_draft.BranchTerminalState,_draft.BranchObservation,_draft.EffectName,_draft.EffectKind,_draft.EffectStatement,_draft.RecoveryName,_draft.RecoveryStrategy,_draft.RecoveryConditionName,_draft.RecoveryCondition,_draft.RecoverySegments,_draft.RecoveryTerminalState,_draft.RecoveryObservation,_draft.RetryPolicy,_draft.IdempotencyAnalysis,_draft.ExitCondition,_draft.Reconciliation,_draft.Reason);using var request=new HttpRequestMessage(HttpMethod.Post,$"api/v1/projects/{ProjectId}/paths"){Content=JsonContent.Create(body)};request.Headers.TryAddWithoutValidation("If-Match",$"\"{_revision}\"");request.Headers.TryAddWithoutValidation("Idempotency-Key",_operationId);using var response=await Http.SendAsync(request);if(response.IsSuccessStatusCode){_committed=await response.Content.ReadFromJsonAsync<DefinePathResponse>();_dirty=false;await Drafts.RemoveAsync(DraftKey);return;}_conflict=response.StatusCode==System.Net.HttpStatusCode.Conflict;var problem=await response.Content.ReadFromJsonAsync<ProjectProblemResponse>();_serverErrors.AddRange(problem?.Errors.SelectMany(x=>x.Value)??[$"The command returned {(int)response.StatusCode}."]);}catch(Exception ex){_serverErrors.Add(ex.Message);}finally{_submitting=false;}}
    private async Task RefreshRevisionAsync(){var model=await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model");if(model is null)return;_model=model;_revision=model.Project.Revision;_operationId=Guid.CreateVersion7().ToString("D");_serverErrors.Clear();_conflict=false;_staleDraft=false;await PersistAsync();}
    private StateLogicResponse? SelectedState=>_model?.StateLogic.FirstOrDefault(x=>x.TransitionId==_draft.SourceTransitionId);private NarrativeResponse? SelectedNarrative=>_model?.Narratives.FirstOrDefault(x=>x.ScenarioId==_draft.ScenarioId);private IReadOnlyList<SemanticResultResponse> AvailableResults=>SelectedState?.Results??[];private string OwnerName=>_model?.Actors.FirstOrDefault(x=>x.Id==_draft.OwnerId)?.Name??"Missing";private string ResultName(string id)=>AvailableResults.FirstOrDefault(x=>x.Id==id)?.Name??"Missing";
    private IReadOnlyList<(string Order,string Kind,string Label,bool Ready)> Nodes=>[("01","Scope",SelectedNarrative?.ScenarioName??"Missing scenario",Has(_draft.ScenarioId)&&Has(_draft.SourceTransitionId)&&Has(_draft.OwnerId)),("02","Condition",Has(_draft.BranchConditionName)?_draft.BranchConditionName:"Missing condition",Has(_draft.BranchName)&&Has(_draft.BranchConditionName)&&Has(_draft.BranchCondition)),("03","Branch",$"{BranchSegmentCount} ordered segments",BranchSegmentCount>0&&Has(_draft.BranchTerminalState)&&Has(_draft.BranchObservation)&&Has(_draft.TerminalResultId)),("04","Effect",Has(_draft.EffectName)?_draft.EffectName:"Missing effect",Has(_draft.EffectName)&&Has(_draft.EffectStatement)),("05","Recovery",Has(_draft.RecoveryName)?_draft.RecoveryName:"Missing recovery",Has(_draft.RecoveryName)&&Has(_draft.RecoveryCondition)&&RecoverySegmentCount>0&&Has(_draft.RecoveryTerminalState)&&Has(_draft.RecoveryObservation)&&Has(_draft.RecoveryResultId)),("06","Closure",Has(_draft.Reason)?"Audit reason supplied":"Missing reason",Has(_draft.Reason))];private int ReadinessCount=>Nodes.Count(x=>x.Ready);private bool CanCommit=>ReadinessCount==6;private int BranchSegmentCount=>Lines(_draft.BranchSegments);private int RecoverySegmentCount=>Lines(_draft.RecoverySegments);
    private string DraftKey=>$"path:{ProjectId}:new";private Task PersistAsync()=>Drafts.WriteAsync(DraftKey,new BrowserDraft<PathDraft>(_revision,_operationId,DateTimeOffset.UtcNow,_draft)).AsTask();private async Task PersistOrRemoveAsync(){_dirty=!Same(_draft,_original);if(_dirty)await PersistAsync();else await Drafts.RemoveAsync(DraftKey);}private static bool Same(PathDraft left,PathDraft right)=>typeof(PathDraft).GetProperties().All(x=>Equals(x.GetValue(left),x.GetValue(right)));private static void Trim(Stack<PathDraft> values){if(values.Count<=50)return;var retained=values.Take(50).Reverse().ToArray();values.Clear();foreach(var value in retained)values.Push(value);}private static bool Has(string value)=>!string.IsNullOrWhiteSpace(value);private static int Lines(string value)=>value.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries).Length;
    private sealed class PathDraft{public string ScenarioId{get;set;}="";public string SourceTransitionId{get;set;}="";public string TerminalResultId{get;set;}="";public string RecoveryResultId{get;set;}="";public string OwnerId{get;set;}="";public string BranchName{get;set;}="Invalid project definition";public string BranchClassification{get;set;}="Exceptional";public string BranchConditionName{get;set;}="Definition is invalid";public string BranchConditionKind{get;set;}="Branch";public string BranchCondition{get;set;}="";public string BranchSegments{get;set;}="";public string BranchTerminalState{get;set;}="";public string BranchObservation{get;set;}="";public string EffectName{get;set;}="Present validation findings";public string EffectKind{get;set;}="Observation";public string EffectStatement{get;set;}="";public string RecoveryName{get;set;}="Correct and resubmit";public string RecoveryStrategy{get;set;}="CorrectAndRetry";public string RecoveryConditionName{get;set;}="Modeler chooses to correct";public string RecoveryCondition{get;set;}="";public string RecoverySegments{get;set;}="";public string RecoveryTerminalState{get;set;}="";public string RecoveryObservation{get;set;}="";public string RetryPolicy{get;set;}="";public string IdempotencyAnalysis{get;set;}="";public string ExitCondition{get;set;}="";public string Reconciliation{get;set;}="";public string Reason{get;set;}="";public PathDraft Copy()=>(PathDraft)MemberwiseClone();}
}

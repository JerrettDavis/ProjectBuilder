@namespace ProjectBuilder.Web.Client.Components
@inject HttpClient Http
@inject NavigationManager Navigation

<section class="problems-workbench" aria-labelledby="problems-heading" data-testid="problems-workbench">
    <header class="problems-header"><div><p class="eyebrow">Review lens · purpose-relative completeness</p><h1 id="problems-heading">Purpose and gap map</h1><p>Compare the same canonical facts against an explicit review purpose, inspect every gating predicate, and open the authored definition that closes each gap.</p></div>@if (_data is not null){<div class="finding-summary"><strong>@UnsatisfiedPredicates/@_data.Predicates.Count</strong><span>profile predicates open</span><small>Revision @_data.Revision · facts unchanged</small></div>}</header>

    @if (_loading){<div class="editor-loading" role="status">Evaluating current model truth…</div>}
    else if (_loadError is not null){<div class="error-summary" role="alert"><h2>Workbench unavailable</h2><p>@_loadError</p><button class="secondary-action" @onclick="LoadAsync">Try again</button></div>}
    else if (_data is not null)
    {
        <section class="purpose-profile-deck" aria-labelledby="purpose-profile-heading" data-testid="purpose-profile-deck"><header><div><p class="eyebrow">Evaluation overlay</p><h2 id="purpose-profile-heading">Review purpose</h2></div><p>Switching profile re-evaluates rules only. It never changes model revision @_data.Revision or silently repairs meaning.</p></header><div class="profile-options">@foreach(var profile in _data.AvailableProfiles){<button type="button" class="profile-option @(profile.Id==_data.Profile.Id?"selected":null)" aria-pressed="@(profile.Id==_data.Profile.Id)" @onclick="()=>SelectProfileAsync(profile.Id)"><span>@(profile.Id=="discovery"?"◇":"◆")</span><strong>@profile.Name</strong><small>@profile.Description</small><em>@(profile.Id==_data.Profile.Id?"Active overlay":"Compare requirements")</em></button>}</div><aside class="profile-boundary governed" role="note"><span aria-hidden="true">⌁</span><div><strong>Governance is part of model history</strong><p>Selected findings can be assumed, deferred, accepted as risk, or marked not applicable with named authority, consequence, review gate, audit reason, and expected revision. The finding remains visible until its semantics are actually repaired.</p></div></aside></section>
        <section class="gap-map" aria-labelledby="gap-map-heading" data-testid="gap-map"><header><div><p class="eyebrow">Definition topology</p><h2 id="gap-map-heading">@_data.Profile.Name gap map</h2></div><span class="profile-revision">Profile overlay · revision @_data.Revision</span></header><div class="gap-map-track" role="list" aria-label="Coverage dimensions">@for(var index=0;index<_data.Coverage.Count;index++){var dimension=_data.Coverage[index];<a role="listitem" class="gap-node @dimension.Status.ToLowerInvariant().Replace(' ','-')" href="@dimension.RepairPath" aria-label="@dimension.Name: @dimension.Status. @dimension.Explanation"><span class="gap-node-index">@(index+1 < 10 ? $"0{index+1}" : index+1)</span><span class="gap-node-status" aria-hidden="true">@(dimension.Status=="Defined"?"✓":dimension.Status=="Gap"?"!":"◇")</span><strong>@dimension.Name</strong><small>@dimension.Status · @(dimension.Required?"required":"visible")</small><p>@dimension.Explanation</p></a>@if(index<_data.Coverage.Count-1){<span class="gap-edge" aria-hidden="true">→</span>}}</div><div class="predicate-rail" aria-label="Profile decision predicates">@foreach(var predicate in _data.Predicates){<div class="predicate @(predicate.Satisfied?"satisfied":"open")"><span aria-hidden="true">@(predicate.Satisfied?"✓":"!")</span><div><strong>@predicate.Name</strong><small>@predicate.Explanation</small></div><code>@predicate.Code</code></div>}</div></section>
        <nav class="workbench-tabs" aria-label="Gap workbench views"><button type="button" class="@(_view=="problems"?"active":null)" aria-current="@(_view=="problems"?"page":null)" @onclick="ShowProblems"><span aria-hidden="true">◆</span> Findings <b>@_data.Findings.Count</b></button><button type="button" class="@(_view=="evidence"?"active":null)" aria-current="@(_view=="evidence"?"page":null)" @onclick="ShowEvidence"><span aria-hidden="true">▦</span> Evidence <b>@_data.EvidenceRequirements.Count</b></button></nav>
        @if(_view=="problems")
        {
            <div class="problems-toolbar" role="search"><label><span>Search findings</span><input value="@_search" @oninput="SearchChanged" placeholder="Code, title, rule, scope…" /></label><label><span>Severity</span><select value="@_severity" @onchange="SeverityChanged"><option>All</option><option>Blocker</option><option>Error</option><option>Warning</option><option>Info</option></select></label><label><span>Category</span><select value="@_category" @onchange="CategoryChanged"><option>All</option>@foreach(var category in Categories){<option>@category</option>}</select></label><button type="button" class="secondary-action" @onclick="ClearFilters" disabled="@(string.IsNullOrEmpty(_search)&&_severity=="All"&&_category=="All")">Clear filters</button></div>
            <div class="severity-strip purpose-severity" aria-label="Finding severity summary"><div class="blocker"><span>Blockers</span><strong>@Count("Blocker")</strong></div><div class="error"><span>Errors</span><strong>@Count("Error")</strong></div><div class="warning"><span>Warnings</span><strong>@Count("Warning")</strong></div><div class="info"><span>Advisories</span><strong>@Count("Info")</strong></div><div class="unknown"><span>Evidence unknown</span><strong>@_data.EvidenceRequirements.Count(x=>x.Status=="Unknown")</strong></div></div>
            @if(FilteredFindings.Count==0){<section class="problems-empty" role="status"><span aria-hidden="true">◇</span><h2>No findings match this view</h2><p>@(_data.Findings.Count==0?"No deterministic rule currently reports a material problem.":"Clear or change the filters to inspect the remaining catalog.")</p></section>}
            else
            {
                <div class="problems-layout"><div class="finding-list" role="list" aria-label="Model findings">@foreach(var finding in FilteredFindings){<button type="button" role="listitem" class="finding-row @finding.Severity.ToLowerInvariant() @(_selected?.Code==finding.Code&&_selected.ScopeId==finding.ScopeId?"selected":null)" @onclick="()=>Select(finding)" aria-pressed="@(_selected?.Code==finding.Code&&_selected.ScopeId==finding.ScopeId)"><span class="severity-symbol" aria-hidden="true">@SeveritySymbol(finding.Severity)</span><span class="finding-copy"><span><code>@finding.Code</code><em>@finding.Category</em></span><strong>@finding.Title</strong><small>@finding.ScopeKind · @finding.ScopeName</small></span><span class="finding-status"><b>@finding.Severity</b><small>@finding.Status</small></span></button>}</div>
                    <aside class="finding-inspector" aria-labelledby="finding-detail-heading">@if(_selected is null){<div class="selection-empty"><span aria-hidden="true">◇</span><h2 id="finding-detail-heading">Select a finding</h2><p>Open its rule, scope, ownership, and safe repair route.</p></div>}else{<div class="finding-detail-heading"><span class="severity-symbol @_selected.Severity.ToLowerInvariant()" aria-hidden="true">@SeveritySymbol(_selected.Severity)</span><div><p>@_selected.Code · @_selected.Severity</p><h2 id="finding-detail-heading">@_selected.Title</h2></div></div><dl class="finding-facts"><div><dt>Status</dt><dd>@_selected.Status · governed</dd></div><div><dt>Owner</dt><dd>@_selected.Owner</dd></div><div><dt>Scope</dt><dd>@_selected.ScopeKind · @_selected.ScopeName</dd></div><div><dt>Category</dt><dd>@_selected.Category</dd></div></dl><section><h3>Why this matters</h3><p>@_selected.Explanation</p></section><section class="rule-explanation"><p class="eyebrow">Rule detail</p><h3>@_selected.Code</h3><p>@_selected.Rule</p><small>Deterministically evaluated against model revision @_data.Revision.</small></section>@if(_selected.DispositionId is not null){<section class="governance-receipt" data-testid="governance-receipt"><p class="eyebrow">Governed disposition</p><h3>@_selected.Status</h3><p>@_selected.DispositionRationale</p><dl><div><dt>Authority</dt><dd>@_selected.AuthorityName</dd></div><div><dt>Consequence</dt><dd>@_selected.DispositionConsequence</dd></div><div><dt>Review gate</dt><dd>@(_selected.ReviewOn??"No scheduled review")</dd></div>@if(_selected.TargetMilestone is not null){<div><dt>Milestone</dt><dd>@_selected.TargetMilestone</dd></div>}</dl><small>The deterministic finding remains visible; this receipt does not claim repair.</small></section>}else{<section class="governance-studio" aria-labelledby="governance-heading" data-testid="governance-studio"><header><p class="eyebrow">Decision studio</p><h3 id="governance-heading">Govern the open gap</h3><p>Finding → authority → consequence → review gate</p></header><div class="disposition-deck" role="radiogroup" aria-label="Disposition">@foreach(var choice in Dispositions){<button type="button" role="radio" aria-checked="@(_disposition==choice.Id)" class="@(_disposition==choice.Id?"selected":null)" @onclick="()=>_disposition=choice.Id"><span>@choice.Symbol</span><strong>@choice.Label</strong><small>@choice.Detail</small></button>}</div><div class="governance-fields"><label><span>Accountable authority</span><select @bind="_authorityId"><option value="">Select modeled actor…</option>@foreach(var authority in _data.Authorities){<option value="@authority.Id">@authority.Name · @authority.ContextualRole</option>}</select></label><label><span>Rationale</span><textarea @bind="_rationale" placeholder="Why is this disposition warranted now?"></textarea></label><label><span>Material consequence</span><textarea @bind="_consequence" placeholder="What remains blocked, uncertain, or exposed?"></textarea></label><label><span>Review / expiration</span><input type="date" value="@_reviewOn" @onchange="ReviewDateChanged" /></label>@if(_disposition=="Deferred"){<label><span>Target milestone</span><input @bind="_targetMilestone" placeholder="C11" /></label>}<label><span>Audit reason</span><input @bind="_reason" placeholder="Record an accountable temporary disposition." /></label></div><div class="governance-chain" aria-label="Commit preview"><span>@_selected.Code</span><i>→</i><span>@(_data.Authorities.FirstOrDefault(x=>x.Id==_authorityId)?.Name??"Authority")</span><i>→</i><span>@DispositionLabel</span><i>→</i><span>@(_reviewOn??"Review gate")</span></div>@if(_saveError is not null){<p class="editor-error" role="alert">@_saveError</p>}<button type="button" class="primary-action" disabled="@_saving" @onclick="RecordDispositionAsync">@(_saving?"Committing governed record…":"Commit disposition at revision "+_data.Revision)</button></section>}<div class="finding-actions"><a class="primary-action" href="@_selected.RepairPath">@(_selected.RepairAvailable?_selected.RepairLabel:"Open requirement")</a><a class="secondary-action" href="/projects/@ProjectId?selected=@_selected.ScopeId">Open exact scope</a></div>@if(!_selected.RepairAvailable){<p class="repair-boundary" role="note"><strong>No resolution command is owned.</strong> This action opens the requirement but cannot mark it resolved.</p>}}</aside>
                </div>
            }
        }
        else
        {
            <section class="evidence-workbench" aria-labelledby="evidence-heading"><header><div><p class="eyebrow">Claim-to-proof matrix</p><h2 id="evidence-heading">Evidence requirements</h2><p>Requirements are modeled or derived; absent runtime artifacts remain Unknown or Required, never silently complete.</p></div><div class="evidence-legend"><span><i class="required"></i>Required</span><span><i class="unknown"></i>Unknown</span></div></header>
                <div class="evidence-matrix" role="table" aria-label="Evidence requirement matrix"><div class="evidence-row header" role="row"><span role="columnheader">Claim</span><span role="columnheader">Example</span><span role="columnheader">Property</span><span role="columnheader">Contract</span><span role="columnheader">E2E</span><span role="columnheader">Ops</span><span role="columnheader">Status</span></div>@foreach(var item in _data.EvidenceRequirements){<a class="evidence-row" role="row" href="@item.ScopePath"><span role="cell"><strong>@item.ClaimName</strong><small>@item.ClaimKind · @item.Owner</small></span>@foreach(var type in EvidenceTypes){<span role="cell" class="evidence-cell">@EvidenceMark(item,type)</span>}<span role="cell" class="evidence-status @item.Status.ToLowerInvariant()">@item.Status</span><span class="requirement-detail">@item.Requirement</span></a>}</div>
                <aside class="evidence-boundary"><span aria-hidden="true">?</span><div><h3>Artifact linkage is not exposed</h3><p>The runtime model query currently carries outcomes and proof expectations but no evidence artifacts, freshness, waivers, or baselines. This matrix therefore reports requirements without inventing proof.</p></div></aside>
            </section>
        }
    }
</section>

@code{
    [Parameter,EditorRequired]public string ProjectId{get;set;}="";[SupplyParameterFromQuery(Name="view")]public string? RequestedView{get;set;}[SupplyParameterFromQuery(Name="profile")]public string? RequestedProfile{get;set;}
    private ProjectFindingsResponse? _data;private ProjectFindingResponse? _selected;private bool _loading=true;private string? _loadError;private string _view="problems",_search="",_severity="All",_category="All";private static readonly string[] EvidenceTypes=["Example","Property","Contract","E2E","Ops"];
    private string _disposition="Deferred",_authorityId="",_rationale="",_consequence="",_targetMilestone="",_reason="";private string? _reviewOn,_saveError;private bool _saving;
    private static readonly (string Id,string Label,string Symbol,string Detail)[] Dispositions=[("Assumed","Assumed","◇","Carry an explicit belief to review."),("Deferred","Deferred","→","Move work to an owned milestone."),("AcceptedRisk","Accepted risk","△","Authorize temporary exposure."),("NotApplicable","Not applicable","⊘","Explain why the rule does not govern this scope.")];
    private string DispositionLabel=>Dispositions.Single(x=>x.Id==_disposition).Label;
    private void ReviewDateChanged(ChangeEventArgs args)=>_reviewOn=args.Value?.ToString();
    protected override Task OnInitializedAsync()=>LoadAsync();protected override void OnParametersSet(){if(RequestedView is "evidence" or "problems")_view=RequestedView;}
    private async Task LoadAsync(){_loading=true;_loadError=null;try{var profile=RequestedProfile is "implementation-ready"?RequestedProfile:"discovery";_data=await Http.GetFromJsonAsync<ProjectFindingsResponse>($"api/v1/projects/{ProjectId}/findings?profile={profile}")??throw new InvalidOperationException("The findings contract returned no content.");_selected=_data.Findings.FirstOrDefault();}catch(Exception ex){_loadError=ex.Message;}finally{_loading=false;}}
    private IReadOnlyList<ProjectFindingResponse> FilteredFindings=>_data?.Findings.Where(x=>(_severity=="All"||x.Severity==_severity)&&(_category=="All"||x.Category==_category)&&(string.IsNullOrWhiteSpace(_search)||$"{x.Code} {x.Title} {x.Rule} {x.ScopeName}".Contains(_search,StringComparison.OrdinalIgnoreCase))).ToArray()??[];private IReadOnlyList<string> Categories=>_data?.Findings.Select(x=>x.Category).Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray()??[];
    private int UnsatisfiedPredicates=>_data?.Predicates.Count(x=>!x.Satisfied)??0;private int Count(string severity)=>_data?.Findings.Count(x=>x.Severity==severity)??0;private void Select(ProjectFindingResponse finding){_selected=finding;_saveError=null;}private void ClearFilters(){_search="";_severity="All";_category="All";}private void ShowProblems()=>SetView("problems");private void ShowEvidence()=>SetView("evidence");private void SetView(string view){_view=view;Navigation.NavigateTo($"/projects/{ProjectId}/problems?view={view}&profile={_data?.Profile.Id??"discovery"}",false,true);}private async Task SelectProfileAsync(string profile){RequestedProfile=profile;Navigation.NavigateTo($"/projects/{ProjectId}/problems?view={_view}&profile={profile}",false,true);await LoadAsync();}private void SearchChanged(ChangeEventArgs e)=>_search=e.Value?.ToString()??string.Empty;private void SeverityChanged(ChangeEventArgs e)=>_severity=e.Value?.ToString()??"All";private void CategoryChanged(ChangeEventArgs e)=>_category=e.Value?.ToString()??"All";private static string SeveritySymbol(string severity)=>severity switch{"Blocker"=>"■","Error"=>"●","Warning"=>"▲",_=>"◇"};private static string EvidenceMark(EvidenceRequirementResponse item,string type)=>item.Status=="Required"&&type is "Example" or "Property"?"!":item.Status=="Unknown"?"?":"·";
    private async Task RecordDispositionAsync(){if(_data is null||_selected is null)return;_saveError=null;if(string.IsNullOrWhiteSpace(_authorityId)||string.IsNullOrWhiteSpace(_rationale)||string.IsNullOrWhiteSpace(_consequence)||string.IsNullOrWhiteSpace(_reason)){_saveError="Authority, rationale, consequence, and audit reason are required.";return;}if(_disposition=="Deferred"&&string.IsNullOrWhiteSpace(_targetMilestone)){_saveError="Deferred work requires a target milestone.";return;}_saving=true;try{using var request=new HttpRequestMessage(HttpMethod.Post,$"api/v1/projects/{ProjectId}/gap-dispositions");request.Headers.Add("Idempotency-Key",Guid.CreateVersion7().ToString());request.Headers.TryAddWithoutValidation("If-Match",$"\"{_data.Revision}\"");request.Content=JsonContent.Create(new RecordGapDispositionRequest(_data.Profile.Id,_selected.Code,_selected.ScopeId,_disposition,_rationale,_consequence,_authorityId,_reviewOn,string.IsNullOrWhiteSpace(_targetMilestone)?null:_targetMilestone,_reason));using var response=await Http.SendAsync(request);if(!response.IsSuccessStatusCode){_saveError=await response.Content.ReadAsStringAsync();return;}var selectedCode=_selected.Code;var selectedScope=_selected.ScopeId;await LoadAsync();_selected=_data?.Findings.SingleOrDefault(x=>x.Code==selectedCode&&x.ScopeId==selectedScope);}catch(Exception ex){_saveError=ex.Message;}finally{_saving=false;}}
}

@namespace ProjectBuilder.Web.Client.Components
@using System.Net.Http.Json
@using ProjectBuilder.Contracts.Projects
@inject HttpClient Http
@inject NavigationManager Navigation

<section class="evidence-composer" data-testid="evidence-composer">
@if(_model is null){<div class="editor-loading">Loading claims and semantic scope…</div>}else{
<header><div><p class="eyebrow">Evidence Studio · claim first</p><h1>Make one proof accountable</h1><p>State the proposition, bind it to semantic scope, then record exactly what the evidence can—and cannot—prove.</p></div><div class="proof-equation"><span>Definition</span><i>+</i><span>Claim</span><i>+</i><span>Evidence</span></div></header>
<form @onsubmit="Commit" @onsubmit:preventDefault><div class="evidence-compose-grid"><div class="evidence-fields">
<fieldset><legend><span>01</span> Scope the promise</legend><label>Outcome<select @bind="_scope">@foreach(var outcome in _model.Outcomes){<option value="@outcome.Id">@outcome.Name</option>}</select></label><label>Authority<select @bind="_owner">@foreach(var actor in _model.Actors){<option value="@actor.Id">@actor.Name</option>}</select></label><div class="field-pair"><label>Claim kind<select @bind="_claimKind"><option value="behavior">Behavior</option><option value="accessibility">Accessibility</option><option value="operational">Operational</option><option value="contract">Contract</option></select></label><label>Status<select @bind="_claimStatus"><option value="required">Required</option><option value="draft">Draft</option><option value="acceptedRisk">Accepted risk</option></select></label></div><label>Reviewable proposition<textarea @bind="_statement" required></textarea></label><label>Tags<textarea @bind="_tags"></textarea></label></fieldset>
<fieldset><legend><span>02</span> Describe the proof</legend><div class="field-pair"><label>Evidence kind<select @bind="_evidenceKind"><option value="endToEndTest">End-to-end test</option><option value="propertyTest">Property test</option><option value="contractTest">Contract test</option><option value="manualReview">Manual review</option></select></label><label>Result<select @bind="_evidenceStatus"><option value="passed">Passed</option><option value="produced">Produced</option><option value="planned">Planned</option><option value="failed">Failed</option></select></label></div><label>Producer<input @bind="_producer" required /></label><label>Environment<input @bind="_environment" required /></label><label>Result summary<textarea @bind="_summary" required></textarea></label><label>Limitations<textarea @bind="_limitations"></textarea></label></fieldset>
</div><aside class="evidence-preview"><p class="eyebrow">Attribution preview</p><h2>@ScopeName</h2><div class="proof-spine"><article><small>Outcome</small><strong>@ScopeName</strong></article><i>↓</i><article><small>@_claimKind claim</small><strong>@_statement</strong><span>@OwnerName</span></article><i>↓</i><article><small>@_evidenceKind · @_evidenceStatus</small><strong>@_producer</strong><span>@_summary</span></article></div><div class="limits"><small>Proof boundary</small><p>@(string.IsNullOrWhiteSpace(_limitations)?"No limitation recorded yet—review before commit.":_limitations)</p></div><p>This preview is view state. Commit creates one claim and one evidence record at the same revision.</p></aside></div>
@if(_error is not null){<div class="error-summary" role="alert">@_error</div>}<footer class="composer-actions"><a href="/projects/@ProjectId/traceability">Cancel</a><label>Audit reason<input @bind="_reason" required /></label><button type="submit" disabled="@_saving">@(_saving?"Committing…":"Commit evidence packet")</button></footer></form>}
</section>
@code {
 [Parameter]public string ProjectId{get;set;}="";[SupplyParameterFromQuery(Name="scope")]public string? Scope{get;set;} private ProjectModelResponse? _model;private bool _saving;private string? _error;private string _scope="",_owner="",_claimKind="behavior",_claimStatus="required",_statement="A contributor can execute the modeled outcome and observe its promised result.",_tags="BDD\nreview-baseline",_evidenceKind="endToEndTest",_evidenceStatus="passed",_producer="ProjectBuilder.EndToEnd.Tests",_environment="headless Chromium · Kestrel · PostgreSQL",_summary="The complete interface journey passed at the current model revision.",_limitations="This example proves one observable path; property and operational claims require separate evidence.",_reason="Attach attributable evidence to a material outcome";
 protected override async Task OnParametersSetAsync(){_model=await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model");_scope=Scope??_model?.Outcomes.FirstOrDefault()?.Id??"";_owner=_model?.Actors.FirstOrDefault()?.Id??"";}private string ScopeName=>_model?.Outcomes.FirstOrDefault(o=>o.Id==_scope)?.Name??"Select outcome";private string OwnerName=>_model?.Actors.FirstOrDefault(a=>a.Id==_owner)?.Name??"Select authority";
 private async Task Commit(){if(_model is null)return;_saving=true;var body=new DefineEvidencePacketRequest(_claimKind,_statement,_claimStatus,[_scope],_owner,_tags,_evidenceKind,_evidenceStatus,_producer,_environment,_summary,_limitations,_reason);using var request=new HttpRequestMessage(HttpMethod.Post,$"api/v1/projects/{ProjectId}/evidence-packets"){Content=JsonContent.Create(body)};request.Headers.Add("If-Match",$"\"{_model.Project.Revision}\"");request.Headers.Add("Idempotency-Key",Guid.CreateVersion7().ToString());var response=await Http.SendAsync(request);if(response.IsSuccessStatusCode)Navigation.NavigateTo($"/projects/{ProjectId}/traceability");else{_error=await response.Content.ReadAsStringAsync();_saving=false;}}
}

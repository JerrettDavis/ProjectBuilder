@namespace ProjectBuilder.Web.Client.Components
@using System.Net.Http.Json
@using ProjectBuilder.Contracts.Projects
@inject HttpClient Http
@inject NavigationManager Navigation

<section class="context-composer" data-testid="system-context-composer">
    <header><div><p class="eyebrow">Architecture studio · atomic context packet</p><h1>Define the crossing, not a box diagram</h1><p>Compose authority, interface intent, boundary semantics, and contract-declared movement as one reviewable revision.</p></div><div class="composer-progress"><span>01 Systems</span><span>02 Interface</span><span>03 Boundary</span><span>04 Contract</span></div></header>
    @if (_model is null) { <div class="editor-loading">Loading canonical participants…</div> }
    else if (_model.Actors.Count < 2) { <div class="error-summary" role="alert"><h2>Two authorities are required</h2><p>Add an owned-system authority and a distinct external authority before defining a known crossing.</p></div> }
    else {
    <form @onsubmit="Commit" @onsubmit:preventDefault>
        <div class="composer-grid">
            <div class="composer-fields">
                <fieldset><legend><span>01</span> Accountable systems</legend><div class="field-pair"><label>Owned system<input @bind="_ownedName" required /></label><label>Owned authority<select @bind="_ownedOwner">@Actors()</select></label></div><label>Purpose<textarea @bind="_ownedPurpose" required></textarea></label><label>Responsibilities<textarea @bind="_ownedResponsibilities" required></textarea></label><div class="field-pair"><label>External system<input @bind="_externalName" required /></label><label>External authority<select @bind="_externalOwner">@Actors()</select></label></div><label>External purpose<textarea @bind="_externalPurpose" required></textarea></label></fieldset>
                <fieldset><legend><span>02</span> Intent-bearing interface</legend><div class="field-pair"><label>Interface name<input @bind="_interfaceName" required /></label><label>Kind<select @bind="_interfaceKind"><option value="http">HTTP</option><option value="graphical">Graphical</option><option value="event">Event</option><option value="humanProcedure">Human procedure</option></select></label></div><label>Accepted intents<textarea @bind="_intents" required></textarea></label><label>Observable responses<textarea @bind="_observations" required></textarea></label><label>Accessibility constraints<textarea @bind="_accessibility"></textarea></label></fieldset>
                <fieldset><legend><span>03</span> Boundary membrane</legend><div class="field-pair"><label>Name<input @bind="_boundaryName" required /></label><label>Kinds<textarea @bind="_boundaryKinds" aria-describedby="kind-help" required></textarea><small id="kind-help">One per line: ownership, trust, protocol…</small></label></div><label>Why this crossing matters<textarea @bind="_boundaryDescription" required></textarea></label><label>Explicit crossing effect<select @bind="_effect"><option value="">No effect reference</option>@foreach (var path in _model.Paths) { <option value="@path.EffectId">@path.EffectName</option> }</select></label></fieldset>
                <fieldset><legend><span>04</span> Governing contract</legend><div class="field-pair"><label>Contract name<input @bind="_contractName" required /></label><label>Kind<select @bind="_contractKind"><option value="api">API</option><option value="message">Message</option><option value="policy">Policy</option></select></label></div><div class="field-pair"><label>Request data<input @bind="_requestData" required /></label><label>Response data<input @bind="_responseData" required /></label></div><div class="field-pair"><label>Classification<input @bind="_classification" required /></label><label>Version<input @bind="_version" required /></label></div><label>Schema reference<input @bind="_schema" required /></label><label>Compatibility policy<textarea @bind="_compatibility" required></textarea></label></fieldset>
            </div>
            <aside class="composer-preview" aria-label="Live context preview"><p class="eyebrow">Live semantic preview</p><h2>One crossing · five definitions</h2><div class="preview-topology"><article><small>Owned</small><strong>@_ownedName</strong><span>@OwnerName(_ownedOwner)</span></article><i>→</i><article class="preview-interface"><small>@_interfaceKind</small><strong>@_interfaceName</strong><span>@_boundaryName</span></article><i>→</i><article><small>External</small><strong>@_externalName</strong><span>@OwnerName(_externalOwner)</span></article></div><div class="preview-flow"><span>→ @_requestData</span><span>← @_responseData</span></div><dl><div><dt>Boundary kinds</dt><dd>@BoundaryKindPreview</dd></div><div><dt>Contract</dt><dd>@_contractName · v@_version</dd></div><div><dt>Classification</dt><dd>@_classification</dd></div></dl><p class="preview-note">Layout is preview state. Commit writes typed semantic definitions through the expected-revision pipeline.</p></aside>
        </div>
        @if (_error is not null) { <div class="error-summary" role="alert">@_error</div> }
        <footer class="composer-actions"><a href="/projects/@ProjectId">Cancel</a><label>Audit reason<input @bind="_reason" required /></label><button type="submit" disabled="@_saving">@(_saving ? "Committing…" : "Commit context packet")</button></footer>
    </form> }
</section>

@code {
    [Parameter] public string ProjectId { get; set; } = ""; private ProjectModelResponse? _model; private bool _saving; private string? _error;
    private string _ownedName="Project Builder", _ownedPurpose="Definition-first modeling studio", _ownedOwner="", _ownedResponsibilities="Preserve canonical semantic truth\nProject accessible deterministic lenses";
    private string _externalName="PostgreSQL", _externalPurpose="Durable development persistence authority", _externalOwner="", _interfaceName="Project model API", _interfaceKind="http", _intents="Commit a revision-safe semantic change", _observations="Accepted revision and typed projection", _accessibility="Every visual topology has a keyboard-operable structured equivalent";
    private string _boundaryName="Application / persistence trust boundary", _boundaryKinds="ownership\ntrust\nprotocol", _boundaryDescription="Separates owned semantic orchestration from an external persistence mechanism", _effect="";
    private string _contractName="Project model persistence contract", _contractKind="api", _requestData="Typed change set", _responseData="Committed revision", _classification="Internal model metadata", _version="1", _schema="Unknown", _compatibility="Additive changes preserve prior readers; breaking changes require a version change", _reason="Define accountable system context and explicit boundary movement";
    protected override async Task OnParametersSetAsync() { _model = await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model"); _ownedOwner = _model?.Actors.FirstOrDefault()?.Id ?? ""; _externalOwner = _model?.Actors.Skip(1).FirstOrDefault()?.Id ?? ""; }
    private RenderFragment Actors() => @<text>@foreach (var actor in _model?.Actors ?? []) { <option value="@actor.Id">@actor.Name</option> }</text>;
    private string OwnerName(string id) => _model?.Actors.FirstOrDefault(a => a.Id == id)?.Name ?? "Select authority";
    private string BoundaryKindPreview => string.Join(" · ", Lines(_boundaryKinds));
    private async Task Commit() { if (_model is null) return; _saving=true; _error=null; var request = new DefineSystemContextRequest(_ownedName,_ownedPurpose,_ownedOwner,_ownedResponsibilities,_externalName,_externalPurpose,_externalOwner,"Store durable records","known",_interfaceName,"Stable server boundary",_interfaceKind,[_ownedOwner],_intents,_observations,_accessibility,_boundaryName,_boundaryDescription,Lines(_boundaryKinds),[_ownedOwner,_externalOwner],"known",string.IsNullOrWhiteSpace(_effect)?null:_effect,_contractName,"Governs request and response movement",_contractKind,_version,_ownedOwner,_schema,_compatibility,_requestData,_responseData,_classification,"known",_reason); using var message=new HttpRequestMessage(HttpMethod.Post,$"api/v1/projects/{ProjectId}/system-contexts"){Content=JsonContent.Create(request)}; message.Headers.Add("If-Match",$"\"{_model.Project.Revision}\""); message.Headers.Add("Idempotency-Key",Guid.CreateVersion7().ToString()); var response=await Http.SendAsync(message); if(response.IsSuccessStatusCode){var result=await response.Content.ReadFromJsonAsync<DefineSystemContextResponse>(); Navigation.NavigateTo($"/projects/{ProjectId}/systems/{result!.Context.OwnedSystemId}/context");}else{_error=await response.Content.ReadAsStringAsync();_saving=false;} }
    private static string[] Lines(string value)=>value.Split(['\r','\n'],StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);
}

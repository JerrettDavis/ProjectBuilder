@namespace ProjectBuilder.Web.Client.Components
@inject HttpClient Http
@inject BrowserDraftStore Drafts

<section id="narrative-editor-workspace" class="narrative-composer" aria-labelledby="narrative-heading" data-testid="narrative-composer">
    <EditorKeyboardShortcuts ScopeId="narrative-editor-workspace" Commit="CommitAsync" Undo="UndoAsync" Redo="RedoAsync" />
    <header class="narrative-header">
        <div><p class="eyebrow">Behavior · scenario flow</p><h1 id="narrative-heading">Define a complete scenario narrative</h1><p>Author an outcome-bearing interaction as one typed, ordered semantic packet. The flow is a projection; commit remains the truth boundary.</p></div>
        <div class="draft-state"><span class="status-dot @(_dirty ? "staged" : "clean")"></span><strong>@(_dirty ? "Staged narrative" : "Clean draft")</strong><small>@ReadinessCount/7 nodes ready</small></div>
    </header>

    @if (_loading) { <div class="editor-loading" role="status">Loading participants and outcomes…</div> }
    else if (_loadError is not null) { <div class="error-summary" role="alert"><h2>Composer unavailable</h2><p>@_loadError</p><button class="secondary-action" @onclick="LoadAsync">Try again</button></div> }
    else if (_actors.Count < 2 || _outcomes.Count == 0) { <section class="editor-empty-state" role="alert"><p class="eyebrow">Narrative prerequisites</p><h2>Two participants and an outcome are required</h2><p>The interaction direction and desired result must reference modeled truth.</p><a class="primary-action" href="/projects/@ProjectId">Return to project overview</a></section> }
    else if (_committed is not null)
    {
        <section class="editor-commit-success" role="status" data-testid="narrative-committed"><p class="eyebrow">Revision @_committed.Revision committed</p><h2>@_committed.Narrative.EpisodeName defined</h2><p>@_committed.Narrative.InitiatorName → @_committed.Narrative.ReceiverName · @_committed.Narrative.Classification path</p><p>@_committed.AllowedNextAction</p><div class="editor-actions"><a class="primary-action" href="/projects/@ProjectId">Review narrative</a><a class="secondary-action" href="/projects/@ProjectId/narratives/new">Compose another</a></div></section>
    }
    else
    {
        @if (_recovered) { <div class="draft-recovery @(_staleDraft ? "stale" : null)" role="status" data-testid="narrative-draft-recovered"><div><p class="eyebrow">Browser-local recovery</p><strong>@(_staleDraft ? "Narrative draft is based on an earlier revision" : "Narrative draft restored after refresh")</strong><p>The ordered flow remains local until its typed command commits.</p></div>@if (_staleDraft) { <button type="button" class="secondary-action" @onclick="RefreshRevisionAsync">Use latest revision and keep draft</button> }</div> }
        <div class="narrative-workspace">
            <aside class="narrative-outline" aria-label="Narrative structure">
                <p class="eyebrow">Ordered outline</p><ol>
                    @foreach (var node in Nodes) { <li class="@(node.Ready ? "ready" : null)"><span>@node.Order</span><div><strong>@node.Kind</strong><small>@node.Label</small></div></li> }
                </ol><p class="outline-note">Order is semantic and committed as 01–07. Multiple sibling ordering is deferred until an add/reorder command owns it.</p>
            </aside>

            <form class="narrative-canvas" @onsubmit="CommitAsync" @onsubmit:preventDefault>
                @if (_serverErrors.Count > 0) { <div class="error-summary" role="alert"><h2>Command rejected</h2><ul>@foreach (var error in _serverErrors) { <li>@error</li> }</ul>@if (_conflict) { <button type="button" class="secondary-action" @onclick="RefreshRevisionAsync">Refresh revision and keep draft</button> }</div> }

                <section class="flow-card episode-card" aria-labelledby="episode-heading"><div class="flow-card-heading"><span>01</span><div><p>Outcome boundary</p><h2 id="episode-heading">Episode</h2></div></div><div class="flow-grid two">
                    <StudioField Descriptor="EpisodeNameField"><input id="episode-name" value="@_draft.EpisodeName" @oninput="e => Change(nameof(_draft.EpisodeName), e.Value?.ToString())" /></StudioField>
                    <StudioField Descriptor="OutcomeField"><select id="episode-outcome" value="@_draft.OutcomeId" @onchange="e => Change(nameof(_draft.OutcomeId), e.Value?.ToString())">@foreach (var outcome in _outcomes) { <option value="@outcome.Id">@outcome.Name</option> }</select></StudioField>
                    <StudioField Descriptor="StartField"><textarea id="episode-start" rows="3" value="@_draft.EpisodeStart" @oninput="e => Change(nameof(_draft.EpisodeStart), e.Value?.ToString())"></textarea></StudioField>
                    <StudioField Descriptor="EndField"><textarea id="episode-end" rows="3" value="@_draft.EpisodeEnd" @oninput="e => Change(nameof(_draft.EpisodeEnd), e.Value?.ToString())"></textarea></StudioField>
                </div></section>

                <div class="flow-connector" aria-hidden="true"><span>↓</span><small>contains · order 02</small></div>
                <section class="flow-card scenario-card" aria-labelledby="scenario-heading"><div class="flow-card-heading"><span>02</span><div><p>Path classification</p><h2 id="scenario-heading">Scenario</h2></div><span class="classification-badge">@_draft.Classification</span></div><div class="flow-grid two">
                    <StudioField Descriptor="ScenarioNameField"><input id="scenario-name" value="@_draft.ScenarioName" @oninput="e => Change(nameof(_draft.ScenarioName), e.Value?.ToString())" /></StudioField>
                    <StudioField Descriptor="ClassificationField"><select id="classification" value="@_draft.Classification" @onchange="e => Change(nameof(_draft.Classification), e.Value?.ToString())">@foreach (var value in Classifications) { <option value="@value">@value</option> }</select></StudioField>
                    <StudioField Descriptor="FactsField"><textarea id="starting-facts" rows="4" value="@_draft.StartingFacts" @oninput="e => Change(nameof(_draft.StartingFacts), e.Value?.ToString())"></textarea></StudioField>
                    <div class="stacked-fields"><StudioField Descriptor="TriggerField"><textarea id="trigger" rows="2" value="@_draft.Trigger" @oninput="e => Change(nameof(_draft.Trigger), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ExpectedField"><textarea id="expected-outcome" rows="2" value="@_draft.ExpectedOutcome" @oninput="e => Change(nameof(_draft.ExpectedOutcome), e.Value?.ToString())"></textarea></StudioField></div>
                </div></section>

                <div class="flow-connector" aria-hidden="true"><span>↓</span><small>contains · order 03</small></div>
                <section class="flow-card scene-card" aria-labelledby="scene-heading"><div class="flow-card-heading"><span>03</span><div><p>Responsibility frame</p><h2 id="scene-heading">Scene</h2></div></div><div class="flow-grid two"><StudioField Descriptor="SceneNameField"><input id="scene-name" value="@_draft.SceneName" @oninput="e => Change(nameof(_draft.SceneName), e.Value?.ToString())" /></StudioField><StudioField Descriptor="SettingField"><textarea id="setting" rows="2" value="@_draft.Setting" @oninput="e => Change(nameof(_draft.Setting), e.Value?.ToString())"></textarea></StudioField><StudioField Descriptor="ResponsibilityField"><textarea id="responsibility" rows="2" value="@_draft.Responsibility" @oninput="e => Change(nameof(_draft.Responsibility), e.Value?.ToString())"></textarea></StudioField></div></section>

                <div class="flow-connector" aria-hidden="true"><span>↓</span><small>contains · order 04</small></div>
                <section class="flow-card interaction-card" aria-labelledby="interaction-heading"><div class="flow-card-heading"><span>04</span><div><p>Participant exchange</p><h2 id="interaction-heading">Interaction</h2></div></div>
                    <StudioField Descriptor="InteractionNameField"><input id="interaction-name" value="@_draft.InteractionName" @oninput="e => Change(nameof(_draft.InteractionName), e.Value?.ToString())" /></StudioField>
                    <div class="participant-lane" data-testid="participant-lane"><label><span>Initiator *</span><select aria-label="Initiator" value="@_draft.InitiatorId" @onchange="e => Change(nameof(_draft.InitiatorId), e.Value?.ToString())">@foreach (var actor in _actors) { <option value="@actor.Id">@actor.Name</option> }</select></label><div class="interaction-arrow"><span aria-hidden="true">→</span><strong>@(Has(_draft.InteractionName) ? _draft.InteractionName : "authored intent")</strong><small>initiates</small></div><label><span>Receiver *</span><select aria-label="Receiver" value="@_draft.ReceiverId" @onchange="e => Change(nameof(_draft.ReceiverId), e.Value?.ToString())">@foreach (var actor in _actors) { <option value="@actor.Id">@actor.Name</option> }</select></label></div>
                    @if (_draft.InitiatorId == _draft.ReceiverId) { <p class="inline-finding" role="alert">Choose different participants so interaction direction is explicit.</p> }
                    <div class="semantic-chain"><div><span>05 · Intent</span><label for="intent">Intent *</label><textarea id="intent" rows="3" value="@_draft.Intent" @oninput="e => Change(nameof(_draft.Intent), e.Value?.ToString())"></textarea></div><i aria-hidden="true">→</i><div><span>06 · Step</span><label for="step">Step *</label><textarea id="step" rows="3" value="@_draft.Step" @oninput="e => Change(nameof(_draft.Step), e.Value?.ToString())"></textarea></div><i aria-hidden="true">→</i><div><span>07 · Observation</span><label for="observation">Observation *</label><textarea id="observation" rows="3" value="@_draft.Observation" @oninput="e => Change(nameof(_draft.Observation), e.Value?.ToString())"></textarea></div></div>
                    <StudioField Descriptor="ResultsField"><textarea id="semantic-results" rows="3" value="@_draft.SemanticResults" @oninput="e => Change(nameof(_draft.SemanticResults), e.Value?.ToString())"></textarea></StudioField>
                </section>

                <section class="commit-preview" aria-labelledby="commit-preview-heading"><div><p class="eyebrow">Atomic change set</p><h2 id="commit-preview-heading">Review semantic operations</h2><p>Seven typed elements, containment, participation, outcome, direction, intent, and observation references commit together at expected revision @_revision.</p></div><StudioField Descriptor="ReasonField"><input id="narrative-reason" value="@_draft.Reason" @oninput="e => Change(nameof(_draft.Reason), e.Value?.ToString())" /></StudioField></section>
                <div class="editor-command-bar"><div><span>Command</span><code>projectbuilder.narrative.define</code><small>Expected revision @_revision · one transaction · Ctrl+S commit</small></div><div class="editor-actions"><button class="secondary-action" type="button" data-testid="narrative-undo" @onclick="UndoAsync" disabled="@(_undo.Count == 0 || _submitting)">Undo</button><button class="secondary-action" type="button" data-testid="narrative-redo" @onclick="RedoAsync" disabled="@(_redo.Count == 0 || _submitting)">Redo</button><button class="secondary-action" type="button" @onclick="ResetAsync" disabled="@(!_dirty || _submitting)">Discard draft</button><button class="primary-action" type="submit" disabled="@(!CanCommit || _submitting || _staleDraft)">@(_submitting ? "Committing…" : "Commit narrative")</button></div></div>
            </form>

            <aside class="narrative-inspector" aria-labelledby="readiness-heading"><p class="eyebrow">Flow inspector</p><h2 id="readiness-heading">Narrative readiness</h2><div class="readiness-score"><strong>@ReadinessCount/7</strong><span>typed nodes ready</span></div><dl><div><dt>Outcome</dt><dd>@(SelectedOutcome?.Name ?? "Missing")</dd></div><div><dt>Path</dt><dd>@_draft.Classification</dd></div><div><dt>Participants</dt><dd>@ParticipantSummary</dd></div><div><dt>Facts</dt><dd>@LineCount(_draft.StartingFacts)</dd></div><div><dt>Results</dt><dd>@LineCount(_draft.SemanticResults)</dd></div></dl><hr/><p class="inspector-note">This canvas does not store layout. Its structured outline and fields expose the same semantic content without drag.</p></aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string ProjectId { get; set; } = string.Empty;
    private readonly List<string> _serverErrors = []; private readonly Stack<NarrativeDraft> _undo = []; private readonly Stack<NarrativeDraft> _redo = []; private NarrativeDraft _draft = new(); private NarrativeDraft _original = new(); private IReadOnlyList<ActorResponse> _actors = []; private IReadOnlyList<OutcomeResponse> _outcomes = []; private long _revision; private string _operationId = Guid.CreateVersion7().ToString("D"); private bool _loading = true, _dirty, _submitting, _conflict, _recovered, _staleDraft; private string? _loadError; private DefineNarrativeResponse? _committed;
    private static readonly string[] Classifications = ["Happy", "Alternate", "Exceptional", "Degraded", "Recovery", "Cancellation", "Compensation"];
    private static readonly StudioFieldDescriptor EpisodeNameField = new("episode-name", "Episode name", "The outcome-bearing boundary for this behavior.", true), OutcomeField = new("episode-outcome", "Desired outcome", "The modeled outcome this episode makes possible.", true), StartField = new("episode-start", "Initiating situation", "What is true before the episode begins.", true), EndField = new("episode-end", "Completion criterion", "What must be observable when the episode is complete.", true), ScenarioNameField = new("scenario-name", "Scenario name", "A concrete path through the episode.", true), ClassificationField = new("classification", "Classification", "Happy, alternate, exceptional, degraded, recovery, cancellation, or compensation.", true), FactsField = new("starting-facts", "Starting facts", "One authoritative fact per line.", true), TriggerField = new("trigger", "Trigger", "The event or intent that starts this path.", true), ExpectedField = new("expected-outcome", "Expected outcome", "The observable condition expected from this scenario.", true), SceneNameField = new("scene-name", "Scene name", "A responsibility-bearing frame within the scenario.", true), SettingField = new("setting", "Setting", "Where or through which interface this scene happens.", true), ResponsibilityField = new("responsibility", "Responsibility", "What this scene must accomplish.", true), InteractionNameField = new("interaction-name", "Interaction name", "The directed exchange between participants.", true), ResultsField = new("semantic-results", "Semantic results", "One explicit result per line; include failures where owned.", true), ReasonField = new("narrative-reason", "Change reason", "Why this complete narrative packet is being committed.", true);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; _loadError = null; try { var model = await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model") ?? throw new InvalidOperationException("The model contract returned no content."); _revision = model.Project.Revision; _actors = model.Actors; _outcomes = model.Outcomes; _draft = new() { OutcomeId = _outcomes.FirstOrDefault()?.Id ?? "", InitiatorId = _actors.FirstOrDefault()?.Id ?? "", ReceiverId = _actors.Skip(1).FirstOrDefault()?.Id ?? _actors.FirstOrDefault()?.Id ?? "", Reason = "Define a complete scenario narrative." }; _original = _draft.Copy(); var saved = await Drafts.ReadAsync<NarrativeDraft>(DraftKey); if (saved is not null) { _draft = saved.Value; _operationId = saved.OperationId; _dirty = true; _recovered = true; _staleDraft = saved.BaseRevision != _revision; } } catch (Exception ex) { _loadError = ex.Message; } finally { _loading = false; } }
    private async Task Change(string field, string? value) { var previous = _draft.Copy(); typeof(NarrativeDraft).GetProperty(field)!.SetValue(_draft, value ?? ""); if (Same(previous, _draft)) return; _undo.Push(previous); Trim(_undo); _redo.Clear(); _dirty = true; await PersistAsync(); }
    private async Task ResetAsync() { _draft = _original.Copy(); _undo.Clear(); _redo.Clear(); _dirty = false; _recovered = false; _staleDraft = false; _serverErrors.Clear(); _operationId = Guid.CreateVersion7().ToString("D"); await Drafts.RemoveAsync(DraftKey); }
    private async Task UndoAsync() { if (_undo.Count == 0) return; _redo.Push(_draft.Copy()); _draft = _undo.Pop(); await PersistOrRemoveAsync(); }
    private async Task RedoAsync() { if (_redo.Count == 0) return; _undo.Push(_draft.Copy()); _draft = _redo.Pop(); await PersistOrRemoveAsync(); }
    private async Task CommitAsync() { if (!CanCommit || _staleDraft) return; _submitting = true; _serverErrors.Clear(); _conflict = false; try { var request = new DefineNarrativeRequest(_draft.OutcomeId, [_draft.InitiatorId, _draft.ReceiverId], _draft.InitiatorId, _draft.ReceiverId, _draft.EpisodeName, _draft.EpisodeStart, _draft.EpisodeEnd, _draft.ScenarioName, _draft.Classification, _draft.StartingFacts, _draft.Trigger, _draft.ExpectedOutcome, _draft.SceneName, _draft.Setting, _draft.Responsibility, _draft.InteractionName, _draft.Intent, _draft.Step, _draft.Observation, _draft.SemanticResults, _draft.Reason); using var message = new HttpRequestMessage(HttpMethod.Post, $"api/v1/projects/{ProjectId}/narratives") { Content = JsonContent.Create(request) }; message.Headers.TryAddWithoutValidation("If-Match", $"\"{_revision}\""); message.Headers.TryAddWithoutValidation("Idempotency-Key", _operationId); using var response = await Http.SendAsync(message); if (response.IsSuccessStatusCode) { _committed = await response.Content.ReadFromJsonAsync<DefineNarrativeResponse>(); _dirty = false; await Drafts.RemoveAsync(DraftKey); return; } _conflict = response.StatusCode == System.Net.HttpStatusCode.Conflict; var problem = await response.Content.ReadFromJsonAsync<ProjectProblemResponse>(); _serverErrors.AddRange(problem?.Errors.SelectMany(x => x.Value) ?? [$"The command returned {(int)response.StatusCode}."]); } catch (Exception ex) { _serverErrors.Add(ex.Message); } finally { _submitting = false; } }
    private async Task RefreshRevisionAsync() { var model = await Http.GetFromJsonAsync<ProjectModelResponse>($"api/v1/projects/{ProjectId}/model"); if (model is null) return; _revision = model.Project.Revision; _operationId = Guid.CreateVersion7().ToString("D"); _serverErrors.Clear(); _conflict = false; _staleDraft = false; await PersistAsync(); }
    private string DraftKey => $"narrative:{ProjectId}:new";
    private Task PersistAsync() => Drafts.WriteAsync(DraftKey, new BrowserDraft<NarrativeDraft>(_revision, _operationId, DateTimeOffset.UtcNow, _draft)).AsTask();
    private async Task PersistOrRemoveAsync() { _dirty = !Same(_draft, _original); if (_dirty) await PersistAsync(); else await Drafts.RemoveAsync(DraftKey); }
    private static bool Same(NarrativeDraft left, NarrativeDraft right) => typeof(NarrativeDraft).GetProperties().All(property => Equals(property.GetValue(left), property.GetValue(right)));
    private static void Trim(Stack<NarrativeDraft> values) { if (values.Count <= 50) return; var retained = values.Take(50).Reverse().ToArray(); values.Clear(); foreach (var value in retained) values.Push(value); }
    private OutcomeResponse? SelectedOutcome => _outcomes.FirstOrDefault(x => x.Id == _draft.OutcomeId); private ActorResponse? Initiator => _actors.FirstOrDefault(x => x.Id == _draft.InitiatorId); private ActorResponse? Receiver => _actors.FirstOrDefault(x => x.Id == _draft.ReceiverId); private string ParticipantSummary => $"{Initiator?.Name ?? "Missing"} → {Receiver?.Name ?? "Missing"}";
    private IReadOnlyList<(string Order, string Kind, string Label, bool Ready)> Nodes => [("01", "Episode", Has(_draft.EpisodeName) ? _draft.EpisodeName : "Untitled boundary", EpisodeReady), ("02", "Scenario", Has(_draft.ScenarioName) ? _draft.ScenarioName : "Untitled path", ScenarioReady), ("03", "Scene", Has(_draft.SceneName) ? _draft.SceneName : "Untitled frame", SceneReady), ("04", "Interaction", Has(_draft.InteractionName) ? _draft.InteractionName : "Undirected exchange", InteractionReady), ("05", "Intent", Has(_draft.Intent) ? _draft.Intent : "Missing intent", Has(_draft.Intent)), ("06", "Step", Has(_draft.Step) ? _draft.Step : "Missing step", Has(_draft.Step)), ("07", "Observation", Has(_draft.Observation) ? _draft.Observation : "Missing observation", Has(_draft.Observation))];
    private bool EpisodeReady => Has(_draft.EpisodeName) && Has(_draft.OutcomeId) && Has(_draft.EpisodeStart) && Has(_draft.EpisodeEnd); private bool ScenarioReady => Has(_draft.ScenarioName) && LineCount(_draft.StartingFacts) > 0 && Has(_draft.Trigger) && Has(_draft.ExpectedOutcome); private bool SceneReady => Has(_draft.SceneName) && Has(_draft.Setting) && Has(_draft.Responsibility); private bool InteractionReady => Has(_draft.InteractionName) && Has(_draft.InitiatorId) && Has(_draft.ReceiverId) && _draft.InitiatorId != _draft.ReceiverId && LineCount(_draft.SemanticResults) > 0; private int ReadinessCount => Nodes.Count(x => x.Ready); private bool CanCommit => ReadinessCount == 7 && Has(_draft.Reason); private static int LineCount(string value) => value.Split(['\r','\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length; private static bool Has(string value) => !string.IsNullOrWhiteSpace(value);
    private sealed class NarrativeDraft { public string OutcomeId { get; set; } = ""; public string InitiatorId { get; set; } = ""; public string ReceiverId { get; set; } = ""; public string EpisodeName { get; set; } = ""; public string EpisodeStart { get; set; } = ""; public string EpisodeEnd { get; set; } = ""; public string ScenarioName { get; set; } = ""; public string Classification { get; set; } = "Happy"; public string StartingFacts { get; set; } = ""; public string Trigger { get; set; } = ""; public string ExpectedOutcome { get; set; } = ""; public string SceneName { get; set; } = ""; public string Setting { get; set; } = ""; public string Responsibility { get; set; } = ""; public string InteractionName { get; set; } = ""; public string Intent { get; set; } = ""; public string Step { get; set; } = ""; public string Observation { get; set; } = ""; public string SemanticResults { get; set; } = ""; public string Reason { get; set; } = ""; public NarrativeDraft Copy() => (NarrativeDraft)MemberwiseClone(); }
}

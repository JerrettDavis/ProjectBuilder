@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using ProjectBuilder.Contracts.Projects
@inject HttpClient Http

<section class="story-studio" aria-labelledby="story-heading">
    @if (_loading) { <div class="editor-loading" role="status">Composing the outcome-centered Story Map…</div> }
    else if (_error is not null) { <div class="error-summary" role="alert"><h1>Story Map unavailable</h1><p>@_error</p></div> }
    else if (_map is not null)
    {
        <header class="story-header">
            <div><p class="eyebrow">Story Map · @_map.ContractVersion</p><h1 id="story-heading">Follow value into behavior</h1><p>Read why the model matters, which abilities produce value, and where concrete stories exercise them.</p></div>
            <div class="story-revision"><span>Canonical snapshot</span><strong>r@_map.Scope.Revision</strong><small>@_map.ContentHash[..12]</small></div>
        </header>
        <div class="story-toolbar">
            <div role="group" aria-label="Story Map overlays"><span>Overlays</span><button type="button" class="@(_priority ? "selected" : null)" aria-pressed="@_priority" @onclick="TogglePriorityAsync">◆ Priority</button><button type="button" class="@(_status ? "selected" : null)" aria-pressed="@_status" @onclick="ToggleStatusAsync">◉ Knowledge</button></div>
            <div class="story-legend" aria-label="Map grammar"><span><i class="solid"></i> semantic value</span><span><i class="dashed"></i> derived trace</span><span><i class="dotted"></i> participation</span></div>
            <button type="button" class="secondary-action" @onclick="ToggleComposer">@(_composerOpen ? "Close capability deck" : "+ Shape capability")</button>
        </div>

        @if (_composerOpen)
        {
            <section class="capability-deck" aria-labelledby="capability-deck-heading" data-testid="capability-deck">
                <header><div><p class="eyebrow">Semantic command · capability.added</p><h2 id="capability-deck-heading">Shape an ability around value</h2><p>Name what the project must be able to do—without prescribing screens, services, or workflow.</p></div><span>Expected revision @_map.Scope.Revision</span></header>
                @if (_commitErrors.Count > 0) { <div class="error-summary" role="alert"><ul>@foreach (var error in _commitErrors) { <li>@error</li> }</ul></div> }
                <div class="capability-flow">
                    <fieldset><legend>1 · Anchor value</legend><div class="outcome-choice-grid">@foreach (var outcome in Outcomes) { <button type="button" class="@(_draft.OutcomeId == outcome.SemanticId ? "selected" : null)" aria-pressed="@(_draft.OutcomeId == outcome.SemanticId)" @onclick="() => ChooseOutcome(outcome)"><span>Outcome</span><strong>@outcome.Title</strong><small>@outcome.Subtitle</small></button> }</div></fieldset>
                    <div class="capability-arrow" aria-hidden="true">→</div>
                    <fieldset><legend>2 · Define ability</legend><label>Capability name<input @bind="_draft.Name" @bind:event="oninput" placeholder="Verify a repository foundation" /></label><label>Ability statement<textarea @bind="_draft.Ability" @bind:event="oninput" placeholder="Build, run, and verify the repository from one documented path."></textarea></label></fieldset>
                    <div class="capability-arrow" aria-hidden="true">→</div>
                    <fieldset><legend>3 · Govern intent</legend><div class="priority-deck" role="radiogroup" aria-label="Capability priority">@foreach (var priority in Priorities) { <button type="button" role="radio" aria-checked="@(_draft.Priority == priority)" class="@(_draft.Priority == priority ? "selected" : null)" @onclick="() => _draft.Priority = priority">@priority</button> }</div><label>Knowledge state<select @bind="_draft.KnowledgeStatus"><option value="known">Known</option><option value="assumed">Assumed</option><option value="unknown">Unknown</option><option value="deferred">Deferred</option><option value="disputed">Disputed</option></select></label><label>Audit reason<input @bind="_draft.Reason" @bind:event="oninput" placeholder="Connect modeled value to an explicit ability." /></label></fieldset>
                </div>
                <footer><div><span>Commit preview</span><strong>@(SelectedOutcome?.Title ?? "Outcome") <i>← contributesTo ←</i> @(_draft.Name.Length > 0 ? _draft.Name : "Capability")</strong></div><button type="button" class="primary-action" disabled="@(!CanCommit || _committing)" @onclick="CommitCapabilityAsync">@(_committing ? "Committing capability…" : "Commit capability")</button></footer>
            </section>
        }

        <div class="story-shell">
            <section class="story-canvas" aria-label="Visual Story Map" tabindex="0" @onkeydown="NavigateAsync" data-testid="story-map-canvas">
                <div class="story-horizon"><header><div><p class="eyebrow">Value horizon</p><h2>Outcomes</h2></div><span>@Outcomes.Count observable</span></header><div class="story-card-row">@foreach (var node in Outcomes) { <StoryMapNodeCard Node="node" Selected="@(_selected?.Id == node.Id)" SelectedChanged="Select" /> }</div></div>
                <div class="story-trace-band" aria-hidden="true"><span></span><i>abilities contribute upward · episodes exercise abilities · stories unfold downward</i><span></span></div>
                <div class="story-tier capability-tier"><header><div><p class="eyebrow">Ability lanes</p><h2>Capabilities</h2></div><span>@Capabilities.Count modeled</span></header>@if (Capabilities.Count == 0) { <button class="story-empty" type="button" @onclick="OpenComposer"><span>+</span><strong>Connect value to an ability</strong><small>The map will not infer capability from workflow.</small></button> } else { <div class="story-card-row">@foreach (var node in Capabilities) { <StoryMapNodeCard Node="node" Selected="@(_selected?.Id == node.Id)" SelectedChanged="Select" /> }</div> }</div>
                <div class="narrative-board">
                    <section><header><span>03</span><div><small>Outcome-bearing bands</small><h2>Episodes</h2></div></header><div class="story-stack">@foreach (var node in Episodes) { <StoryMapNodeCard Node="node" Selected="@(_selected?.Id == node.Id)" SelectedChanged="Select" /> }</div></section>
                    <section><header><span>04</span><div><small>Concrete paths</small><h2>Scenarios</h2></div></header><div class="story-stack">@foreach (var node in Scenarios) { <StoryMapNodeCard Node="node" Selected="@(_selected?.Id == node.Id)" SelectedChanged="Select" /> }</div></section>
                    <section><header><span>05</span><div><small>Responsibility frames</small><h2>Scenes</h2></div></header><div class="story-stack">@foreach (var node in Scenes) { <StoryMapNodeCard Node="node" Selected="@(_selected?.Id == node.Id)" SelectedChanged="Select" /> }</div></section>
                </div>
                <section class="participant-orbit"><header><div><p class="eyebrow">Participation orbit</p><h2>Actors in this story</h2></div><span>@Participants.Count participating</span></header><div>@foreach (var node in Participants) { <button type="button" class="@(_selected?.Id == node.Id ? "selected" : null)" @onclick="() => Select(node)"><span>@Initials(node.Title)</span><strong>@node.Title</strong><small>@node.Subtitle</small></button> }</div></section>
                <p class="story-boundary"><strong>Map, not model:</strong> vertical placement, focus, selection, and overlays are derived view state. Containment and value references remain canonical.</p>
            </section>
            <aside class="story-inspector">
                @if (_selected is null) { <p class="eyebrow">Story inspector</p><h2>Select a card</h2><p>Trace definition, knowledge, priority, and relationships from one immutable projection.</p> }
                else { <p class="eyebrow">@_selected.Kind · @_selected.Group</p><h2>@_selected.Title</h2><p>@_selected.Subtitle</p><div class="story-badges">@foreach (var badge in _selected.Badges) { <span>@badge</span> }</div><dl><div><dt>Semantic ID</dt><dd>@_selected.SemanticId</dd></div><div><dt>Knowledge</dt><dd>@_selected.Status</dd></div><div><dt>Inbound</dt><dd>@Inbound(_selected.Id)</dd></div><div><dt>Outbound</dt><dd>@Outbound(_selected.Id)</dd></div></dl>@foreach (var section in _selected.Inspector) { <section><h3>@section.Label</h3>@foreach (var field in section.Fields) { <div><span>@field.Label</span><p>@field.Value</p><small>@field.KnowledgeStatus</small></div> }</section> }<section class="story-relations"><h3>Trace ribbon</h3>@foreach (var edge in Related(_selected.Id)) { <p title="@edge.Origin"><i class="@Pattern(edge.Pattern)"></i><span>@edge.Kind</span><strong>@Other(edge, _selected.Id)</strong></p> }@if (!Related(_selected.Id).Any()) { <p>No visible connectors in this scope.</p> }</section>@if (_selected.Kind == "scenario") { <a class="primary-action" href="/projects/@ProjectId/scenarios/@_selected.SemanticId/flow">Open Scenario Flow</a> }
                }
            </aside>
        </div>
        <section class="story-outline" aria-labelledby="story-outline-heading"><header><div><p class="eyebrow">Structured equivalent</p><h2 id="story-outline-heading">Value-to-scene trace</h2></div><p>Every visual card appears once in deterministic reading order. Arrow keys, Home, and End move canvas selection.</p></header><ol>@foreach (var item in _map.AccessibilityTree) { <li><button type="button" @onclick="() => SelectById(item.NodeId)"><span>@item.Position.ToString("00")</span><div><strong>@item.Label</strong><small>@item.Status · @item.InboundCount in · @item.OutboundCount out</small></div><i>@Group(item.NodeId)</i></button></li> }</ol>@if (_map.Diagnostics.Count > 0) { <div class="story-diagnostics" role="status">@foreach (var diagnostic in _map.Diagnostics) { <p><span>@diagnostic.Severity</span><code>@diagnostic.Code</code>@diagnostic.Message</p> }</div> }</section>
    }
</section>

@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    private LensProjectionResponse? _map; private LensNodeResponse? _selected; private bool _loading = true; private bool _priority = true; private bool _status = true; private bool _composerOpen; private bool _committing; private string? _error; private readonly List<string> _commitErrors = []; private CapabilityDraft _draft = new();
    private static readonly string[] Priorities = ["Critical", "High", "Normal", "Low"];
    private IReadOnlyList<LensNodeResponse> Outcomes => Kind("outcome"); private IReadOnlyList<LensNodeResponse> Capabilities => Kind("capability"); private IReadOnlyList<LensNodeResponse> Episodes => Kind("episode"); private IReadOnlyList<LensNodeResponse> Scenarios => Kind("scenario"); private IReadOnlyList<LensNodeResponse> Scenes => Kind("scene"); private IReadOnlyList<LensNodeResponse> Participants => Kind("actor"); private LensNodeResponse? SelectedOutcome => Outcomes.FirstOrDefault(node => node.SemanticId == _draft.OutcomeId); private bool CanCommit => !string.IsNullOrWhiteSpace(_draft.OutcomeId) && !string.IsNullOrWhiteSpace(_draft.Name) && !string.IsNullOrWhiteSpace(_draft.Ability) && !string.IsNullOrWhiteSpace(_draft.Reason);
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() { _loading = true; _error = null; try { var overlays = new List<string>(); if (_priority) overlays.Add("priority"); if (_status) overlays.Add("status"); _map = await Http.GetFromJsonAsync<LensProjectionResponse>($"api/v1/projects/{ProjectId}/lenses/story-map?overlay={string.Join(',', overlays)}") ?? throw new InvalidOperationException("The Story Map contract returned no content."); _selected = _map.Nodes.FirstOrDefault(node => node.Id == _selected?.Id) ?? _map.Nodes.FirstOrDefault(); if (string.IsNullOrWhiteSpace(_draft.OutcomeId)) _draft.OutcomeId = Outcomes.FirstOrDefault()?.SemanticId ?? ""; } catch (Exception ex) { _error = ex.Message; } finally { _loading = false; } }
    private IReadOnlyList<LensNodeResponse> Kind(string kind) => _map?.Nodes.Where(node => node.Kind == kind).ToArray() ?? [];
    private void Select(LensNodeResponse node) => _selected = node; private void SelectById(string id) => _selected = _map?.Nodes.FirstOrDefault(node => node.Id == id);
    private void ToggleComposer() => _composerOpen = !_composerOpen; private void OpenComposer() => _composerOpen = true; private void ChooseOutcome(LensNodeResponse node) => _draft.OutcomeId = node.SemanticId;
    private async Task TogglePriorityAsync() { _priority = !_priority; await LoadAsync(); } private async Task ToggleStatusAsync() { _status = !_status; await LoadAsync(); }
    private async Task CommitCapabilityAsync() { if (!CanCommit || _map is null) return; _committing = true; _commitErrors.Clear(); try { using var request = new HttpRequestMessage(HttpMethod.Post, $"api/v1/projects/{ProjectId}/capabilities") { Content = JsonContent.Create(new AddCapabilityRequest(_draft.Name, _draft.Ability, [_draft.OutcomeId], _draft.Priority, _draft.Reason, _draft.KnowledgeStatus)) }; request.Headers.TryAddWithoutValidation("If-Match", $"\"{_map.Scope.Revision}\""); request.Headers.TryAddWithoutValidation("Idempotency-Key", Guid.CreateVersion7().ToString()); using var response = await Http.SendAsync(request); if (!response.IsSuccessStatusCode) { var raw = await response.Content.ReadAsStringAsync(); try { var problem = System.Text.Json.JsonSerializer.Deserialize<ProjectProblemResponse>(raw, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }); _commitErrors.AddRange(problem?.Errors.SelectMany(item => item.Value) ?? []); } catch (System.Text.Json.JsonException) { } if (_commitErrors.Count == 0) _commitErrors.Add($"Capability command returned {(int)response.StatusCode}. Retry or inspect the local server logs."); return; } _draft = new(); _composerOpen = false; await LoadAsync(); _selected = Capabilities.LastOrDefault(); } catch (Exception ex) { _commitErrors.Add(ex.Message); } finally { _committing = false; } }
    private Task NavigateAsync(KeyboardEventArgs args) { if (_map is null || _map.Nodes.Count == 0) return Task.CompletedTask; var index = Math.Max(0, _map.Nodes.ToList().FindIndex(node => node.Id == _selected?.Id)); index = args.Key switch { "ArrowRight" or "ArrowDown" => (index + 1) % _map.Nodes.Count, "ArrowLeft" or "ArrowUp" => (index - 1 + _map.Nodes.Count) % _map.Nodes.Count, "Home" => 0, "End" => _map.Nodes.Count - 1, _ => index }; _selected = _map.Nodes[index]; return Task.CompletedTask; }
    private int Inbound(string id) => _map?.Edges.Count(edge => edge.TargetNodeId == id) ?? 0; private int Outbound(string id) => _map?.Edges.Count(edge => edge.SourceNodeId == id) ?? 0; private IEnumerable<LensEdgeResponse> Related(string id) => _map?.Edges.Where(edge => edge.SourceNodeId == id || edge.TargetNodeId == id) ?? []; private string Other(LensEdgeResponse edge, string id) { var other = edge.SourceNodeId == id ? edge.TargetNodeId : edge.SourceNodeId; return _map?.Nodes.FirstOrDefault(node => node.Id == other)?.Title ?? other; } private string Group(string id) => _map?.Nodes.FirstOrDefault(node => node.Id == id)?.Group ?? "Unknown"; private static string Pattern(string pattern) => pattern.Contains("dotted", StringComparison.Ordinal) ? "dotted" : pattern.Contains("dashed", StringComparison.Ordinal) ? "dashed" : "solid"; private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(word => char.ToUpperInvariant(word[0])));
    private sealed class CapabilityDraft { public string OutcomeId { get; set; } = ""; public string Name { get; set; } = ""; public string Ability { get; set; } = ""; public string Priority { get; set; } = "Normal"; public string KnowledgeStatus { get; set; } = "known"; public string Reason { get; set; } = ""; }
}

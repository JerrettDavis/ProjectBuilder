@namespace ProjectBuilder.Web.Client.Components
@using System.Net.Http.Json
@using ProjectBuilder.Contracts.Projects
@inject HttpClient Http

<section class="trace-atlas" data-testid="traceability-atlas" tabindex="0" @onkeydown="HandleKey">
@if (_model is null) { <div class="editor-loading">Tracing outcomes to attributable proof…</div> }
else {
    <header class="trace-hero"><div><p class="eyebrow">Traceability Atlas · @_model.ContractVersion</p><h1>From promised value to proof</h1><p>Follow why a definition exists, which claim it supports, and whether its evidence is current.</p></div><dl><div><dt>Baseline</dt><dd>r@_model.Scope.Revision</dd></div><div><dt>Projection</dt><dd>@_model.ContentHash[..8]</dd></div></dl></header>
    <nav class="trace-modes" aria-label="Traceability representations">@foreach (var mode in Modes) { <button class="@(_view==mode.Id?"active":null)" @onclick="()=>Load(mode.Id)" aria-pressed="@(_view==mode.Id)"><span>@mode.Mark</span><strong>@mode.Label</strong><small>@mode.Note</small></button> }</nav>
    <div class="trace-workbench">
        <main class="trace-stage">
        @if (_view == "outcomes") {
            <section class="trace-river" data-testid="trace-outcome-river" aria-label="Outcome to evidence paths">
                <header><span>Promised outcome</span><span>Reviewable claim</span><span>Attributable evidence</span></header>
                @foreach (var trace in _model.OutcomeTraces) {
                    var outcome=Find("outcome",trace.OutcomeId); var claims=trace.ClaimIds.Select(id=>Find("claim",id)).Where(n=>n is not null); var evidence=trace.EvidenceIds.Select(id=>Find("evidence",id)).Where(n=>n is not null);
                    <article class="trace-stream @trace.Status"><button @onclick="()=>Select(outcome!.Id)"><small>outcome</small><strong>@trace.OutcomeName</strong><em>@trace.Status</em></button><i>→</i><div>@if(claims.Any()){@foreach(var node in claims){@Card(node!)}}else{<a class="trace-gap" href="/projects/@ProjectId/evidence/new?scope=@trace.OutcomeId">+ shape the claim</a>}</div><i>→</i><div>@if(evidence.Any()){@foreach(var node in evidence){@Card(node!)}}else{<span class="trace-gap">No evidence linked</span>}</div><p>@trace.Explanation</p></article>
                }
            </section>
        } else if (_view == "debt") {
            <section class="evidence-debt" data-testid="trace-debt"><p class="eyebrow">Evidence debt</p><h2>Material links that remain unresolved</h2>@if(_model.MissingLinks.Count==0){<div class="all-clear"><span>✓</span><strong>No missing outcome links at this baseline</strong></div>}else{@foreach(var gap in _model.MissingLinks){<article><span>@gap.Code</span><div><h3>@gap.ScopeName</h3><p>@gap.Explanation</p></div><strong>@gap.MissingLink</strong><a href="@gap.RepairPath">Attach proof</a></article>}}</section>
        } else {
            <section class="impact-radar" data-testid="trace-impact"><p class="eyebrow">Change impact</p><h2>Which proof must be reconsidered?</h2><div class="impact-axis" aria-hidden="true"></div>@foreach(var item in _model.Impact){<article class="@item.Status"><div class="impact-revision">@($"r{item.ChangedAtRevision}")</div><div><h3>@item.ScopeName</h3><p>@item.Reason</p></div><span>@item.Status</span></article>}</section>
        }
        </main>
        <aside class="trace-inspector" data-testid="trace-inspector">@if(Selected is not null){<p class="eyebrow">@Selected.Kind · @Selected.Origin</p><h2>@Selected.Title</h2><p>@Selected.Detail</p><div class="inspector-badges">@foreach(var badge in Selected.Badges){<span>@badge</span>}</div>@foreach(var section in Selected.Inspector){<section><h3>@section.Label</h3><dl>@foreach(var field in section.Fields){<div><dt>@field.Label</dt><dd>@field.Value</dd></div>}</dl></section>}<code>@Selected.SemanticReference</code>}</aside>
    </div>
    <section class="trace-outline"><div><p class="eyebrow">Structured equivalent</p><h2>Every node in deterministic order</h2></div><ol>@foreach(var item in _model.AccessibilityTree){var node=_model.Nodes.Single(n=>n.Id==item.NodeId);<li><button class="@(_selected==node.Id?"active":null)" @onclick="()=>Select(node.Id)"><span>@item.Position.ToString("00")</span><strong>@node.Kind · @node.Title</strong><small>@node.Status · @item.InboundCount in · @item.OutboundCount out</small></button></li>}</ol></section>
}
</section>

@code {
 [Parameter] public string ProjectId {get;set;}=""; private TraceabilityProjectionResponse? _model; private string _view="outcomes"; private string? _selected;
 private static readonly (string Id,string Mark,string Label,string Note)[] Modes=[("outcomes","↗","Outcome paths","Value to proof"),("debt","◇","Evidence debt","Missing or stale links"),("impact","◎","Impact radar","Changed definitions")];
 private TraceNodeResponse? Selected=>_model?.Nodes.FirstOrDefault(n=>n.Id==_selected)??_model?.Nodes.FirstOrDefault();
 protected override Task OnParametersSetAsync()=>Load(_view); private async Task Load(string view){_view=view;_model=await Http.GetFromJsonAsync<TraceabilityProjectionResponse>($"api/v1/projects/{ProjectId}/lenses/traceability?view={view}");_selected??=_model?.Nodes.FirstOrDefault()?.Id;}
 private TraceNodeResponse? Find(string kind,string id)=>_model?.Nodes.FirstOrDefault(n=>n.Kind==kind&&n.SemanticReference==id); private RenderFragment Card(TraceNodeResponse node)=>@<button class="trace-card @node.Status @(_selected==node.Id?"selected":null)" @onclick="()=>Select(node.Id)"><small>@node.Kind</small><strong>@node.Title</strong><em>@node.Status</em></button>; private void Select(string id)=>_selected=id;
 private void HandleKey(KeyboardEventArgs args){if(_model is null||args.Key is not("ArrowRight" or "ArrowDown" or "ArrowLeft" or "ArrowUp" or "Home" or "End"))return;var i=Math.Max(0,_model.Nodes.ToList().FindIndex(n=>n.Id==_selected));i=args.Key switch{"Home"=>0,"End"=>_model.Nodes.Count-1,"ArrowLeft" or "ArrowUp"=>Math.Max(0,i-1),_=>Math.Min(_model.Nodes.Count-1,i+1)};_selected=_model.Nodes[i].Id;}
}

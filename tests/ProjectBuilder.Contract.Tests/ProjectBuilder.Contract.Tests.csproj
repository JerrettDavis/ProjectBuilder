<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\schemas\*.schema.json" Link="Contracts\Schemas\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
